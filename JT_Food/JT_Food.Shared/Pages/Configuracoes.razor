@page "/configuracoes"
@using JT_Classes.Restaurante
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Services.Implementations
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Interfaces
@using JT_UserInterface.Shared.Components.Core
@using Microsoft.JSInterop
@inherits JT_UserInterface.Shared.Pages.Comum.ConfiguracoesBase<MFoodConfiguracao, IMFoodConfiguracaoService>
@inject IImpressaoRedeService ImpressaoService
@inject IIAAnalyticsService IAService
@inject IJSRuntime JSRuntime
@inject JT_Servicos.IA.ConfiguracaoIAService ConfiguracaoIAService

@RenderizarFormularioConfiguracoes()

@if (modalImpressoraAberto)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-printer me-2"></i>@(impressoraEdicao.Id == 0 ? "Nova Impressora" : "Editar Impressora")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => modalImpressoraAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Nome do Setor:</label>
                        <input type="text" class="form-control" @bind="impressoraEdicao.NomeSetor" placeholder="Ex: Cozinha Central, Bar, Chapa" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label fw-bold small text-muted">Endereço IP (Rede Local):</label>
                            <input type="text" class="form-control" @bind="impressoraEdicao.EnderecoIp" placeholder="Ex: 192.168.1.201" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-muted">Porta TCP:</label>
                            <input type="number" class="form-control" @bind="impressoraEdicao.PortaTcp" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Tipo de Destino:</label>
                            <select class="form-select" @bind="impressoraEdicao.Tipo">
                                <option value="Cozinha">Cozinha</option>
                                <option value="Bar">Bar</option>
                                <option value="Chapa">Chapa / Lanches</option>
                                <option value="Caixa">Caixa</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Largura da Bobina:</label>
                            <select class="form-select" @bind="impressoraEdicao.LarguraColunas">
                                <option value="48">80mm (48 colunas)</option>
                                <option value="32">58mm (32 colunas)</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="checkImpAtiva" @bind="impressoraEdicao.Ativa" />
                        <label class="form-check-label fw-bold text-dark" for="checkImpAtiva">Impressora Ativa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => modalImpressoraAberto = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SalvarImpressoraAsync">
                        <i class="bi bi-save me-1"></i> Salvar Impressora
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public override string ObterTituloPagina() => "Configurações do Restaurante";

    private List<ImpressoraRede> impressoras = new();
    private bool modalImpressoraAberto = false;
    private ImpressoraRede impressoraEdicao = new();
    private bool testandoConexao = false;

    private double valorCouvertPadrao = 15.00;
    private bool ativarCouvertAutomatico = true;
    private string horaInicioCouvert = "19:00";
    private string horaFimCouvert = "23:00";

    private string geminiApiKey = GeminiRelatorioService.CustomApiKey ?? "";
    private string modeloIa = GeminiRelatorioService.CustomModel ?? "gemini-1.5-flash";
    private bool identificandoModelos = false;
    private bool mostrarApiKey = false;
    private List<GeminiModelInfo> modelosDisponiveis = new();
    private string? statusIaMensagem;
    private string statusIaClasse = "alert-info";

    private string? mensagemAlerta;
    private string classeAlerta = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        impressoras = await ImpressaoService.ObterImpressorasAsync();
    }

    protected override async Task CarregarTabsInjetadasAsync()
    {
        await base.CarregarTabsInjetadasAsync();
        if (InjectedTabs != null && InjectedTabs.Count > 1)
        {
            var distinctTabs = InjectedTabs
                .GroupBy(t => t.Titulo, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(t => t.Ordem)
                .ToList();

            InjectedTabs.Clear();
            InjectedTabs.AddRange(distinctTabs);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedKey = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "jt_gemini_api_key");
                var savedModel = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "jt_gemini_model");

                bool alterou = false;
                if (!string.IsNullOrWhiteSpace(savedKey))
                {
                    geminiApiKey = savedKey;
                    GeminiRelatorioService.CustomApiKey = savedKey;
                    alterou = true;
                }
                else
                {
                    var configs = await ConfiguracaoIAService.GetAll();
                    var configAtiva = configs.FirstOrDefault();
                    if (!string.IsNullOrWhiteSpace(configAtiva?.ApiKey))
                    {
                        geminiApiKey = configAtiva.ApiKey;
                        GeminiRelatorioService.CustomApiKey = configAtiva.ApiKey;
                        alterou = true;
                    }
                }

                if (!string.IsNullOrWhiteSpace(savedModel))
                {
                    modeloIa = savedModel;
                    GeminiRelatorioService.CustomModel = savedModel;
                    alterou = true;
                }
                else
                {
                    var configs = await ConfiguracaoIAService.GetAll();
                    var configAtiva = configs.FirstOrDefault();
                    if (!string.IsNullOrWhiteSpace(configAtiva?.Modelo))
                    {
                        modeloIa = configAtiva.Modelo;
                        GeminiRelatorioService.CustomModel = configAtiva.Modelo;
                        alterou = true;
                    }
                }

                var cachedModelsJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "jt_gemini_models_cache");
                if (!string.IsNullOrWhiteSpace(cachedModelsJson))
                {
                    try
                    {
                        var cached = System.Text.Json.JsonSerializer.Deserialize<List<GeminiModelInfo>>(cachedModelsJson);
                        if (cached != null && cached.Count > 0)
                        {
                            modelosDisponiveis = cached;
                            alterou = true;
                        }
                    }
                    catch { }
                }

                if (modelosDisponiveis.Count == 0 && !string.IsNullOrWhiteSpace(geminiApiKey))
                {
                    var res = await IAService.IdentificarModelosDisponiveisAsync(geminiApiKey);
                    if (res.Sucesso && res.Modelos.Count > 0)
                    {
                        modelosDisponiveis = res.Modelos;
                        alterou = true;
                        try
                        {
                            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_models_cache", System.Text.Json.JsonSerializer.Serialize(modelosDisponiveis));
                        }
                        catch { }
                    }
                }

                if (alterou)
                {
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignora falhas em pré-renderização sem JS
            }
        }
    }

    public override RenderFragment? TabsAdicionais => 
        @<text>
            <TabPage Title="Impressoras Térmicas ESC/POS">
                <div class="py-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-printer text-primary me-2"></i>Roteamento de Impressoras Térmicas por Setor</h6>
                            <small class="text-muted">Cadastre impressoras com IP e Porta 9100 para envio automático de pedidos da cozinha e bar.</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="NovaImpressora">
                            <i class="bi bi-plus-lg me-1"></i> Nova Impressora
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemAlerta))
                    {
                        <div class="alert @classeAlerta alert-dismissible fade show mb-3" role="alert">
                            <small>@mensagemAlerta</small>
                            <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
                        </div>
                    }

                    <div class="row g-3">
                        @foreach (var imp in impressoras)
                        {
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge @(imp.Ativa ? "bg-primary" : "bg-secondary")">@imp.Tipo</span>
                                                <span class="badge @(imp.UltimaImpressaoOk ? "bg-success" : "bg-danger")">
                                                    <i class="bi @(imp.UltimaImpressaoOk ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
                                                    @(imp.UltimaImpressaoOk ? "Conectada" : "Offline")
                                                </span>
                                            </div>

                                            <h6 class="fw-bold text-dark mb-1">@imp.NomeSetor</h6>
                                            <p class="text-muted small mb-2">
                                                <i class="bi bi-hdd-network me-1"></i>@imp.EnderecoIp : @imp.PortaTcp
                                                <br /><i class="bi bi-receipt me-1"></i>Largura: @(imp.LarguraColunas == 48 ? "80mm (48 col)" : "58mm (32 col)")
                                            </p>
                                        </div>

                                        <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => TestarConexaoAsync(imp)" disabled="@testandoConexao">
                                                <i class="bi bi-arrow-repeat me-1"></i> Testar
                                            </button>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-primary" @onclick="() => EditarImpressora(imp)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" @onclick="() => ExcluirImpressora(imp.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </TabPage>

            <TabPage Title="Couvert Artístico">
                <div class="py-3" style="max-width: 700px;">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-music-note-beamed text-primary me-2"></i>Parâmetros de Música ao Vivo & Eventos</h6>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Valor Padrão por Pessoa (R$):</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number" class="form-control" @bind="valorCouvertPadrao" step="0.50" min="0" />
                        </div>
                        <small class="text-muted">Valor sugerido automaticamente ao abrir comandas e mesas.</small>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="checkAtivacaoAutomatica" @bind="ativarCouvertAutomatico" />
                        <label class="form-check-label fw-bold text-dark" for="checkAtivacaoAutomatica">
                            Ativação Automática nos Dias de Evento
                        </label>
                        <small class="d-block text-muted">Aplica a taxa de couvert automaticamente nas mesas e comandas abertas durante a janela do evento.</small>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Horário Início:</label>
                            <input type="time" class="form-control" value="@horaInicioCouvert" @onchange="@(e => horaInicioCouvert = e.Value?.ToString() ?? "")" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Horário Término:</label>
                            <input type="time" class="form-control" value="@horaFimCouvert" @onchange="@(e => horaFimCouvert = e.Value?.ToString() ?? "")" />
                        </div>
                    </div>

                    <button type="button" class="btn btn-success" @onclick="SalvarCouvert">
                        <i class="bi bi-save me-1"></i> Salvar Parâmetros de Couvert
                    </button>
                </div>
            </TabPage>

            <TabPage Title="Inteligência Artificial (Gemini)">
                <div class="py-3" style="max-width: 750px;">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle me-3">
                            <i class="bi bi-robot fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Parametrização Google Gemini AI</h6>
                            <small class="text-muted">Informe sua Google Gemini API Key e identifique os modelos habilitados para sua conta.</small>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(statusIaMensagem))
                    {
                        <div class="alert @statusIaClasse alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
                            <i class="bi @(statusIaClasse.Contains("success") ? "bi-check-circle-fill" : statusIaClasse.Contains("danger") ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill") me-2 fs-5"></i>
                            <div class="flex-grow-1 small">
                                @statusIaMensagem
                                @if (statusIaClasse.Contains("danger") && (statusIaMensagem.Contains("AI Studio") || statusIaMensagem.Contains("inválida")))
                                {
                                    <span class="d-block mt-1">
                                        <a href="https://aistudio.google.com/app/apikey" target="_blank" class="fw-bold text-decoration-underline text-danger">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Acessar Google AI Studio para gerar uma nova API Key válida
                                        </a>
                                    </span>
                                }
                            </div>
                            <button type="button" class="btn-close" @onclick="() => statusIaMensagem = null"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Google Gemini API Key:</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key-fill text-muted"></i></span>
                            <input type="@(mostrarApiKey ? "text" : "password")" 
                                   class="form-control font-monospace" 
                                   @bind="geminiApiKey" 
                                   placeholder="Cole sua API Key do Google AI Studio (ex: AIzaSy...)" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => mostrarApiKey = !mostrarApiKey" title="Visualizar chave">
                                <i class="bi @(mostrarApiKey ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                            <button class="btn btn-primary fw-semibold px-3" 
                                     type="button" 
                                     @onclick="IdentificarModelosAsync" 
                                     disabled="@(identificandoModelos || string.IsNullOrWhiteSpace(geminiApiKey))">
                                @if (identificandoModelos)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Identificando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cpu me-1"></i>
                                    <span>Identificar Modelos</span>
                                }
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">A chave é utilizada para consultar a API oficial do Gemini de forma segura.</small>
                            <a href="https://aistudio.google.com/app/apikey" target="_blank" class="small text-decoration-none">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Obter Chave no Google AI Studio
                            </a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small text-muted mb-0">Modelo de Linguagem:</label>
                            @if (modelosDisponiveis.Count > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-lg me-1"></i>@modelosDisponiveis.Count modelos identificados
                                </span>
                            }
                        </div>
                        <select class="form-select" @bind="modeloIa">
                            @if (modelosDisponiveis.Count > 0)
                            {
                                @foreach (var mod in modelosDisponiveis)
                                {
                                    <option value="@mod.Id">@mod.DisplayName (@mod.Id)</option>
                                }
                            }
                            else
                            {
                                <option value="gemini-1.5-flash">Gemini 1.5 Flash (Ultra Rápido e Otimizado)</option>
                                <option value="gemini-1.5-pro">Gemini 1.5 Pro (Raciocínio Profundo e Diagnósticos Avançados)</option>
                                <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
                                <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(ObterDescricaoModeloSelecionado()))
                        {
                            <small class="text-muted d-block mt-1 fst-italic">
                                <i class="bi bi-info-circle me-1"></i>@ObterDescricaoModeloSelecionado()
                            </small>
                        }
                    </div>

                    <div class="p-3 bg-light rounded border mb-4">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-check text-success fs-3 me-3"></i>
                            <div>
                                <strong class="text-dark">Motor Analítico Híbrido Ativo</strong>
                                <small class="d-block text-muted">Se a chave não for informada ou a cota do Google esgotar, o sistema utiliza automaticamente o motor analítico inteligente embutido sem custo adicional.</small>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary px-4 fw-semibold shadow-sm" @onclick="SalvarIaConfig">
                        <i class="bi bi-save me-1"></i> Salvar Configuração de IA
                    </button>
                </div>
            </TabPage>
        </text>;

    private void NovaImpressora()
    {
        impressoraEdicao = new ImpressoraRede();
        modalImpressoraAberto = true;
    }

    private void EditarImpressora(ImpressoraRede imp)
    {
        impressoraEdicao = imp;
        modalImpressoraAberto = true;
    }

    private async Task SalvarImpressoraAsync()
    {
        await ImpressaoService.SalvarImpressoraAsync(impressoraEdicao);
        modalImpressoraAberto = false;
        impressoras = await ImpressaoService.ObterImpressorasAsync();
        ExibirAlerta("Impressora salva com sucesso!", "alert-success");
    }

    private async Task ExcluirImpressora(int id)
    {
        await ImpressaoService.ExcluirImpressoraAsync(id);
        impressoras = await ImpressaoService.ObterImpressorasAsync();
        ExibirAlerta("Impressora removida.", "alert-info");
    }

    private async Task TestarConexaoAsync(ImpressoraRede imp)
    {
        testandoConexao = true;
        var res = await ImpressaoService.TestarConexaoAsync(imp);
        testandoConexao = false;
        ExibirAlerta(res.Mensagem, res.Sucesso ? "alert-success" : "alert-warning");
    }

    private void SalvarCouvert()
    {
        ExibirAlerta("Parâmetros de Couvert Artístico atualizados!", "alert-success");
    }

    private async Task IdentificarModelosAsync()
    {
        if (string.IsNullOrWhiteSpace(geminiApiKey))
        {
            statusIaMensagem = "Por favor, informe a Google Gemini API Key antes de identificar os modelos.";
            statusIaClasse = "alert-warning";
            return;
        }

        identificandoModelos = true;
        statusIaMensagem = "Consultando a API do Google para identificar modelos disponíveis...";
        statusIaClasse = "alert-info";
        StateHasChanged();

        try
        {
            var res = await IAService.IdentificarModelosDisponiveisAsync(geminiApiKey);
            if (res.Sucesso && res.Modelos.Count > 0)
            {
                modelosDisponiveis = res.Modelos;
                if (!modelosDisponiveis.Any(m => m.Id == modeloIa))
                {
                    modeloIa = modelosDisponiveis.First().Id;
                }
                statusIaMensagem = res.Mensagem;
                statusIaClasse = "alert-success";
                try
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_models_cache", System.Text.Json.JsonSerializer.Serialize(modelosDisponiveis));
                }
                catch { }
            }
            else
            {
                statusIaMensagem = res.Mensagem;
                statusIaClasse = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            statusIaMensagem = $"Erro ao identificar modelos: {ex.Message}";
            statusIaClasse = "alert-danger";
        }
        finally
        {
            identificandoModelos = false;
            StateHasChanged();
        }
    }

    private string ObterDescricaoModeloSelecionado()
    {
        var mod = modelosDisponiveis.FirstOrDefault(m => m.Id == modeloIa);
        return mod?.Description ?? "";
    }

    private async Task SalvarIaConfig()
    {
        GeminiRelatorioService.CustomApiKey = geminiApiKey;
        GeminiRelatorioService.CustomModel = modeloIa;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_api_key", geminiApiKey ?? "");
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_model", modeloIa ?? "gemini-1.5-flash");
            if (modelosDisponiveis.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jt_gemini_models_cache", System.Text.Json.JsonSerializer.Serialize(modelosDisponiveis));
            }
        }
        catch
        {
            // Ignora exceção em casos de localStorage desabilitado
        }

        try
        {
            // Sincroniza diretamente com o serviço global do Assistente IA (ChatInstrutor)
            var configs = await ConfiguracaoIAService.GetAll();
            var configIa = configs.FirstOrDefault() ?? new JT_Classes.IA.ConfiguracaoIA();
            configIa.ApiKey = geminiApiKey ?? string.Empty;
            configIa.Modelo = modeloIa ?? "gemini-1.5-flash";
            configIa.Provedor = "Gemini";
            await ConfiguracaoIAService.Save(configIa);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Configuracoes] Aviso ao sincronizar com Assistente IA: {ex.Message}");
        }

        statusIaMensagem = $"Configurações da Inteligência Artificial salvas! Modelo ativo: {modeloIa}";
        statusIaClasse = "alert-success";
        ExibirAlerta("Configurações da Inteligência Artificial salvas com sucesso!", "alert-success");
    }

    private void ExibirAlerta(string msg, string classe)
    {
        mensagemAlerta = msg;
        classeAlerta = classe;
    }
}

