@page "/producao"
@using JT_Classes.Acessos
@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Servicos.Restaurante
@using JT_UserInterface.Shared.Components
@inject ProducaoLogic ProducaoLogic
@inject ProdutoRestauranteService ProdutoService
@inject JT_Servicos.Restaurante.ProducaoService ProducaoService
@inject JT_Classes.Acessos.CurrentUserState UserState

<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col">
            <h3 class="mb-0">ProduÃ§Ã£o</h3>
            <p class="text-muted">Registro de produÃ§Ã£o e baixa automÃ¡tica de insumos.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show" role="alert">
            @mensagemAlerta
            <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
        </div>
    }

    <div class="row">
        <!-- Coluna de Registro -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Nova ProduÃ§Ã£o</h5>
                    <p class="card-text text-muted">A produÃ§Ã£o consumirÃ¡ insumos baseados no mÃ©todo FIFO (lote mais antigo primeiro).</p>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Produto</label>
                        <select class="form-select" @bind="produtoSelecionadoId">
                            <option value="">Selecione um Produto...</option>
                            @foreach (var prod in produtosComReceita)
                            {
                                <option value="@prod.Id">@prod.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Quantidade Produzida</label>
                        <input type="number" class="form-control" @bind="quantidadeProduzida" min="0.1" step="0.1" />
                    </div>

                    <button class="btn btn-primary w-100" @onclick="RegistrarProducaoAsync" disabled="@isProcessando">
                        @if (isProcessando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Processando...</span>
                        }
                        else
                        {
                            <i class="fas fa-industry me-2"></i><span>Registrar ProduÃ§Ã£o e Baixar Estoque</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- Coluna de HistÃ³rico -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Ãšltimas ProduÃ§Ãµes</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CarregarHistoricoAsync">
                        <i class="fas fa-sync-alt"></i> Atualizar
                    </button>
                </div>
                <div class="card-body">
                    @if (historicoProducao.Count == 0)
                    {
                        <p class="text-muted">Nenhum registro de produÃ§Ã£o recente.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Data/Hora</th>
                                        <th>Produto</th>
                                        <th>Qtd</th>
                                        <th>Custo Calc.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prod in historicoProducao.OrderByDescending(x => x.DataProducao).Take(5))
                                    {
                                        <tr>
                                            <td>@prod.DataProducao.ToString("dd/MM HH:mm")</td>
                                            <td>@prod.NomeProduto</td>
                                            <td>@prod.QuantidadeProduzida</td>
                                            <td>R$ @prod.CustoTotalCalculado.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MProduto> produtosComReceita = new();
    private List<MProducao> historicoProducao = new();
    
    private string produtoSelecionadoId = "";
    private double quantidadeProduzida = 1;
    
    private bool isProcessando = false;
    private string? mensagemAlerta = null;
    private string classeAlerta = "alert-info";
    
    private string CurrentUserId = "1"; // TODO: Bind to Auth later.

    protected override async Task OnInitializedAsync()
    {
        CurrentUserId = UserState.UsuarioID.ToString();
        await CarregarDadosIniciaisAsync();
    }

    private async Task CarregarDadosIniciaisAsync()
    {
        produtosComReceita = await ProdutoService.Find($"UserId = '{UserState.UsuarioID}'") ?? new List<MProduto>();
        await CarregarHistoricoAsync();
    }

    private async Task CarregarHistoricoAsync()
    {
        historicoProducao = await ProducaoService.Find($"OperadorId = '{UserState.UsuarioID}'") ?? new List<MProducao>();
    }

    private async Task RegistrarProducaoAsync()
    {
        if (string.IsNullOrEmpty(produtoSelecionadoId) || quantidadeProduzida <= 0)
        {
            ExibirAlerta("Selecione um produto e uma quantidade vÃ¡lida.", "alert-warning");
            return;
        }

        isProcessando = true;
        mensagemAlerta = null;
        StateHasChanged();

        var resultado = await ProducaoLogic.ProcessarProducaoAsync(produtoSelecionadoId, quantidadeProduzida, CurrentUserId);

        if (resultado.Sucesso)
        {
            ExibirAlerta(resultado.Mensagem, "alert-success");
            
            // Limpa form e recarrega histÃ³rico
            produtoSelecionadoId = "";
            quantidadeProduzida = 1;
            await CarregarHistoricoAsync();
        }
        else
        {
            ExibirAlerta(resultado.Mensagem, "alert-danger");
        }

        isProcessando = false;
        StateHasChanged();
    }

    private void ExibirAlerta(string mensagem, string classeCss)
    {
        mensagemAlerta = mensagem;
        classeAlerta = classeCss;
    }
}

