@page "/configuracoes"
@using JT_UserInterface.Shared.Pages
@using JT_Food.Shared.Models
@using JT_Food.Shared.Services
@using JT_Classes.Comum
@inherits Configuracoes

@code {
    protected override async Task CarregarConfiguracoes()
    {
        // Usa o serviço específico do Food para carregar a configuração do restaurante
        configuracaoAtual = ConfiguracaoService.Get();
        if (configuracaoAtual != null && configuracaoAtual.IdUsuario == 0 && UserState != null && UserState.UsuarioID > 0)
        {
            configuracaoAtual.IdUsuario = UserState.UsuarioID;
        }
        await Task.CompletedTask;
    }

    protected override Configuracao CriarNovaConfiguracao()
    {
        return new MConfiguracao { Id = 0 };
    }
}
