@page "/comandas"
@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Components
@using JT_Food.Shared.Services.Interfaces
@inject IComandaService ComandaService
@inject CaixaLogic CaixaLogic
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Comandas e Atendimento - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-card-checklist text-primary me-2"></i>Comandas e Atendimento
            </h1>
            <p class="text-muted small mb-0">Pesquise por número do cartão, cliente ou mesa e gerencie pedidos.</p>
        </div>
        <button class="btn @(caixaAberto ? "btn-primary" : "btn-secondary") shadow-sm" @onclick="NovaComanda" data-tutorial="comandas-nova">
            <i class="fas @(caixaAberto ? "fa-plus" : "fa-lock") fa-sm text-white-50 me-2"></i> Nova Comanda Flexível
        </button>
    </div>

    @if (!caixaAberto && !loading)
    {
        <div class="alert alert-warning border-warning border-2 d-flex flex-wrap justify-content-between align-items-center shadow-sm p-3 mb-4 rounded-3" role="alert">
            <div class="d-flex align-items-center me-3 mb-2 mb-md-0">
                <i class="bi bi-lock-fill fs-2 text-warning me-3"></i>
                <div>
                    <strong class="text-dark d-block fs-6">Caixa Fechado no Momento</strong>
                    <span class="small text-muted">A abertura de novas comandas e lançamentos de pedidos estão bloqueados até que um turno de caixa seja aberto.</span>
                </div>
            </div>
            <button class="btn btn-warning fw-bold text-dark px-3 py-2 shadow-sm" @onclick='() => Navigation.NavigateTo("/caixa")'>
                <i class="bi bi-unlock-fill me-1"></i> Abrir Caixa Agora
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensagemAlerta
            <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
        </div>
    }

    <div data-tutorial="comandas-grid">
        <GridComandas Comandas="comandas" IsLoading="loading" OnEdit="EditarComanda" OnDelete="ExcluirComanda" />
    </div>
</div>

<ModalComanda @ref="modalComanda" Comanda="comandaSelecionada" OnSaved="CarregarAsync" />

@code {
    private List<Comanda>? comandas;
    private bool loading = true;
    private bool caixaAberto = true;
    private string? mensagemAlerta;
    private Comanda comandaSelecionada = new();
    private ModalComanda modalComanda = default!;
    private DotNetObjectReference<VerComandas>? _pageRef;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        loading = true;
        var statusCaixa = await CaixaLogic.ObterCaixaAbertoAsync();
        caixaAberto = statusCaixa.Sucesso;
        comandas = await ComandaService.GetAllAsync();
        loading = false;
        StateHasChanged();
    }

    private void NovaComanda()
    {
        if (!caixaAberto)
        {
            mensagemAlerta = "Não é possível abrir comandas com o caixa fechado. Por favor, abra o caixa antes de continuar.";
            return;
        }
        comandaSelecionada = new Comanda { UserId = "1", DataAbertura = DateTime.UtcNow };
        modalComanda.Open(comandaSelecionada, "dados");
    }

    private void EditarComanda(Comanda c)
    {
        comandaSelecionada = c;
        modalComanda.Open(comandaSelecionada, "pedidos");
    }

    private async Task ExcluirComanda(Comanda c)
    {
        if (await ComandaService.DeleteAsync(c.Id))
        {
            await CarregarAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pageRef == null)
        {
            _pageRef = DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _pageRef); } catch { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(NovaComanda);
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            if (_pageRef != null)
            {
                JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys");
                _pageRef.Dispose();
                _pageRef = null;
            }
        }
        catch { }
    }
}
