@page "/comandas"
@using JT_Classes.Restaurante
@using JT_Food.Shared.Services
@using JT_Food.Shared.Components

<PageTitle>Gerenciar Comandas - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Comandas</h1>
        <button class="btn btn-primary" @onclick="NovaComanda">
            <i class="fas fa-plus me-2"></i> Abrir Nova Comanda
        </button>
    </div>

    <GridComandas Comandas="comandas" IsLoading="loading" OnEdit="Editar" OnDelete="Excluir" />
</div>

<ModalComanda @ref="modalComanda" Comanda="comandaSelecionada" OnSaved="Carregar" />

@code {
    private List<Comanda>? comandas;
    private bool loading = true;
    private Comanda comandaSelecionada = new();
    private ModalComanda modalComanda = default!;

    protected override void OnInitialized() => Carregar();

    private void Carregar()
    {
        loading = true;
        comandas = ComandaService.GetAll();
        loading = false;
        StateHasChanged();
    }

    private async Task NovaComanda()
    {
        comandaSelecionada = new Comanda { UserId = "1", DataAbertura = DateTime.UtcNow };
        modalComanda.Open();
    }

    private async Task Editar(Comanda c)
    {
        comandaSelecionada = c;
        modalComanda.Open();
    }

    private void Excluir(Comanda c)
    {
        if (ComandaService.Delete(c.Id)) Carregar();
    }
}



