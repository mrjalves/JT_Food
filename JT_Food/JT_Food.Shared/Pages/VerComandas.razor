@page "/comandas"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.Components

@inject ComandaService ComandaService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Comandas - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Comandas e Pedidos</h1>
        <button class="btn btn-primary shadow-sm" @onclick="NovaComanda">
            <i class="fas fa-plus fa-sm text-white-50 me-2"></i> Nova Comanda
        </button>
    </div>

    <GridComandas Comandas="comandas" IsLoading="loading" OnEdit="EditarComanda" OnDelete="ExcluirComanda" />
</div>

<ModalComanda @ref="modalComanda" Comanda="comandaSelecionada" OnSaved="CarregarAsync" />

@code {
    private List<Comanda>? comandas;
    private bool loading = true;
    private Comanda comandaSelecionada = new();
    private ModalComanda modalComanda = default!;
    private DotNetObjectReference<VerComandas>? _pageRef;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        loading = true;
        comandas = await ComandaService.GetAll();
        loading = false;
        StateHasChanged();
    }

    private async Task NovaComanda()
    {
        comandaSelecionada = new Comanda { UserId = "1", DataAbertura = DateTime.UtcNow };
        modalComanda.Open();
    }

    private async Task EditarComanda(Comanda c)
    {
        comandaSelecionada = c;
        modalComanda.Open();
    }

    private async Task ExcluirComanda(Comanda c)
    {
        if (await ComandaService.Delete(c.Id))
        {
            await CarregarAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pageRef == null)
        {
            _pageRef = DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _pageRef); } catch { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(NovaComanda);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleAcaoHotkey(string acao)
    {
        switch (acao)
        {
            case "salvar":
                if (modalComanda.IsOpen)
                    await modalComanda.SalvarAsync();
                break;
            case "cancelar":
                if (modalComanda.IsOpen)
                    modalComanda.Close();
                break;
            case "editar":
                if (comandaSelecionada.Id != 0)
                    await InvokeAsync(() => EditarComanda(comandaSelecionada));
                break;
            case "deletar":
                if (comandaSelecionada.Id != 0)
                    await InvokeAsync(() => ExcluirComanda(comandaSelecionada));
                break;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            if (_pageRef != null)
            {
                JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys");
                _pageRef.Dispose();
                _pageRef = null;
            }
        }
        catch { }
    }
}
