@page "/comandas"
@using JT_Classes.Restaurante
@using JT_Food.Shared.Components
@using JT_Food.Shared.Services.Interfaces
@inject IComandaService ComandaService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Comandas e Atendimento - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-card-checklist text-primary me-2"></i>Comandas e Atendimento
            </h1>
            <p class="text-muted small mb-0">Pesquise por número do cartão, cliente ou mesa e gerencie pedidos.</p>
        </div>
        <button class="btn btn-primary shadow-sm" @onclick="NovaComanda">
            <i class="fas fa-plus fa-sm text-white-50 me-2"></i> Nova Comanda Flexível
        </button>
    </div>

    <GridComandas Comandas="comandas" IsLoading="loading" OnEdit="EditarComanda" OnDelete="ExcluirComanda" />
</div>

<ModalComanda @ref="modalComanda" Comanda="comandaSelecionada" OnSaved="CarregarAsync" />

@code {
    private List<Comanda>? comandas;
    private bool loading = true;
    private Comanda comandaSelecionada = new();
    private ModalComanda modalComanda = default!;
    private DotNetObjectReference<VerComandas>? _pageRef;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        loading = true;
        comandas = await ComandaService.GetAllAsync();
        loading = false;
        StateHasChanged();
    }

    private void NovaComanda()
    {
        comandaSelecionada = new Comanda { UserId = "1", DataAbertura = DateTime.UtcNow };
        modalComanda.Open(comandaSelecionada, "dados");
    }

    private void EditarComanda(Comanda c)
    {
        comandaSelecionada = c;
        modalComanda.Open(comandaSelecionada, "pedidos");
    }

    private async Task ExcluirComanda(Comanda c)
    {
        if (await ComandaService.DeleteAsync(c.Id))
        {
            await CarregarAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pageRef == null)
        {
            _pageRef = DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _pageRef); } catch { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(NovaComanda);
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            if (_pageRef != null)
            {
                JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys");
                _pageRef.Dispose();
                _pageRef = null;
            }
        }
        catch { }
    }
}
