@page "/mesas"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.Components
@using JT_Food.Shared.Components.Salao
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Services.Interfaces
@using JT_Food.Shared.Services.Implementations
@using JT_Food.Shared.BusinessLogic
@inject MesaService MesaService
@inject IMesaLayoutService MesaLayoutService
@inject IAuthPerfilService AuthService
@inject CaixaLogic CaixaLogic
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Salão e Mesas - JT Food</PageTitle>

<div class="container-fluid py-4">
    <!-- Cabeçalho Principal com Modos de Visualização -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Salão e Mesas
            </h1>
            <p class="text-muted small mb-0">Gestão operacional de mesas, comandas agrupadas e construtor visual de salão.</p>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <!-- Alternador de Modos -->
            <div class="btn-group shadow-sm" role="group" data-tutorial="mesas-modos">
                <button type="button"
                        class="btn @(modoVisualizacao == "mapa" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => AlterarModoVisualizacaoAsync("mapa")'>
                    <i class="bi bi-map-fill me-1"></i> Mapa Operacional
                </button>
                @if (AuthService.IsGerente())
                {
                    <button type="button"
                            class="btn @(modoVisualizacao == "construtor" ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => AlterarModoVisualizacaoAsync("construtor")'>
                        <i class="bi bi-pencil-square me-1"></i> Construtor de Salão
                    </button>
                }
                <button type="button"
                        class="btn @(modoVisualizacao == "grid" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => AlterarModoVisualizacaoAsync("grid")'>
                    <i class="bi bi-list-ul me-1"></i> Lista em Tabela
                </button>
            </div>

            <button class="btn btn-success shadow-sm" @onclick="NovaMesa" data-tutorial="mesas-novo">
                <i class="fas fa-plus fa-sm text-white-50 me-2"></i> Nova Mesa
            </button>
        </div>
    </div>

    @if (!caixaAberto)
    {
        <div class="alert alert-warning border-warning d-flex align-items-center justify-content-between p-3 shadow-sm rounded-3 mb-4" data-tutorial="mesas-alerta-caixa">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
                <div>
                    <strong class="d-block text-dark">Atenção: Turno de Caixa Fechado</strong>
                    <span class="text-muted small">O salão está em modo de consulta. Para abrir novas comandas e lançar pedidos nas mesas, abra um turno de caixa.</span>
                </div>
            </div>
            <button class="btn btn-warning text-dark fw-bold px-3 shadow-sm" @onclick='() => Navigation.NavigateTo("/caixa")'>
                <i class="bi bi-cash-stack me-1"></i> Abrir Caixa Agora
            </button>
        </div>
    }

    <!-- Renderização Condicional pelo Modo Selecionado -->
    <div data-tutorial="mesas-mapa">
        @if (modoVisualizacao == "mapa")
        {
            <MapaInterativoSalao @ref="mapaSalaoRef" OnElementoSelecionado="HandleElementoSelecionado" />
        }
        else if (modoVisualizacao == "construtor")
        {
            <ConstrutorLayoutMesas OnCancelar='() => AlterarModoVisualizacaoAsync("mapa")' />
        }
        else
        {
            <GridMesas Mesas="mesas" IsLoading="loading" OnEdit="EditarMesa" OnDelete="ExcluirMesa" />
        }
    </div>
</div>

<ModalMesa @ref="modalMesa" Mesa="mesaSelecionada" OnSaved="RecarregarAsync" />

@code {
    private List<JT_Classes.Restaurante.Mesa>? mesas;
    private bool loading = true;
    private bool caixaAberto = true;
    private JT_Classes.Restaurante.Mesa mesaSelecionada = new();
    private ModalMesa modalMesa = default!;
    private MapaInterativoSalao? mapaSalaoRef;
    private string modoVisualizacao = "mapa";
    private DotNetObjectReference<Mesas>? _pageRef;

    protected override async Task OnInitializedAsync()
    {
        var statusCaixa = await CaixaLogic.ObterCaixaAbertoAsync();
        caixaAberto = statusCaixa.Sucesso;
        await CarregarMesasAsync();
    }

    private async Task AlterarModoVisualizacaoAsync(string novoModo)
    {
        modoVisualizacao = novoModo;
        await RecarregarAsync();
    }

    private async Task CarregarMesasAsync()
    {
        loading = true;
        mesas = await MesaLayoutService.ObterMesasSincronizadasAsync();
        loading = false;
        StateHasChanged();
    }

    private async Task RecarregarAsync()
    {
        var statusCaixa = await CaixaLogic.ObterCaixaAbertoAsync();
        caixaAberto = statusCaixa.Sucesso;
        await CarregarMesasAsync();
        if (mapaSalaoRef != null)
        {
            await mapaSalaoRef.CarregarAmbientesAsync();
        }
    }

    private void NovaMesa()
    {
        mesaSelecionada = new JT_Classes.Restaurante.Mesa { Capacidade = 4 };
        int ambAtivo = mapaSalaoRef?.AmbienteAtivoId ?? 1;
        modalMesa.Open(mesaSelecionada, "dados", ambAtivo);
    }

    private void EditarMesa(JT_Classes.Restaurante.Mesa mesa)
    {
        mesaSelecionada = mesa;
        int ambAtivo = mapaSalaoRef?.AmbienteAtivoId ?? 1;
        modalMesa.Open(mesaSelecionada, "comandas", ambAtivo);
    }

    private async Task ExcluirMesa(JT_Classes.Restaurante.Mesa mesa)
    {
        var todasDb = await MesaService.GetAll() ?? new();
        var correspondentes = todasDb
            .Where(m => m.Id == mesa.Id || ComandaOperacionalService.MesmaMesa(m.Identificacao, mesa.Identificacao))
            .ToList();

        foreach (var item in correspondentes)
        {
            if (item.Id > 0)
            {
                try { await MesaService.Delete(item.Id); } catch { }
            }
        }

        await MesaLayoutService.RemoverElementoPorIdentificacaoAsync(mesa.Identificacao);
        await RecarregarAsync();
    }

    private async Task HandleElementoSelecionado(ElementoSalao elemento)
    {
        // Se for um elemento com capacidade (mesa/balcão), busca por identificação normalizada para nunca duplicar
        var mesaCorrespondente = mesas?.FirstOrDefault(m =>
            ComandaOperacionalService.MesmaMesa(m.Identificacao, elemento.Identificacao));
        
        if (mesaCorrespondente == null || mesaCorrespondente.Id == 0)
        {
            var todasDb = await MesaService.GetAll() ?? new();
            var existenteDb = todasDb.FirstOrDefault(m =>
                ComandaOperacionalService.MesmaMesa(m.Identificacao, elemento.Identificacao));

            if (existenteDb != null)
            {
                mesaCorrespondente = existenteDb;
            }
            else
            {
                mesaCorrespondente = new JT_Classes.Restaurante.Mesa
                {
                    Identificacao = MesaLayoutService.FormatarIdentificacaoCanonica(elemento.Identificacao),
                    Capacidade = elemento.Capacidade > 0 ? elemento.Capacidade : 4,
                    Status = elemento.Status
                };
                await MesaService.SaveAsync(mesaCorrespondente);
            }
            mesas = await MesaLayoutService.ObterMesasSincronizadasAsync();
            mesaCorrespondente = mesas.FirstOrDefault(m =>
                ComandaOperacionalService.MesmaMesa(m.Identificacao, elemento.Identificacao)) ?? mesaCorrespondente;
        }

        mesaSelecionada = mesaCorrespondente;
        modalMesa.Open(mesaSelecionada, "comandas", elemento.AmbienteId > 0 ? elemento.AmbienteId : 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pageRef == null)
        {
            _pageRef = DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _pageRef); } catch { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(NovaMesa);
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            if (_pageRef != null)
            {
                JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys");
                _pageRef.Dispose();
                _pageRef = null;
            }
        }
        catch { }
    }
}
