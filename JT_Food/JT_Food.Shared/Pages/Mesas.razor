@page "/mesas"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.Components

@inject MesaService MesaService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Gestão de Mesas - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Mesas e Salão</h1>
        <button class="btn btn-primary shadow-sm" @onclick="NovaMesa">
            <i class="fas fa-plus fa-sm text-white-50 me-2"></i> Nova Mesa
        </button>
    </div>

    <GridMesas Mesas="mesas" IsLoading="loading" OnEdit="EditarMesa" OnDelete="ExcluirMesa" />
</div>

<ModalMesa @ref="modalMesa" Mesa="mesaSelecionada" OnSaved="CarregarMesasAsync" />

@code {
    private List<Mesa>? mesas;
    private bool loading = true;
    private Mesa mesaSelecionada = new();
    private ModalMesa modalMesa = default!;
    private DotNetObjectReference<Mesas>? _pageRef;

    protected override async Task OnInitializedAsync()
    {
        await CarregarMesasAsync();
    }

    private async Task CarregarMesasAsync()
    {
        loading = true;
        mesas = await MesaService.GetAll();
        loading = false;
        StateHasChanged();
    }

    private async Task NovaMesa()
    {
        mesaSelecionada = new Mesa();
        modalMesa.Open();
    }

    private async Task EditarMesa(Mesa mesa)
    {
        mesaSelecionada = mesa;
        modalMesa.Open();
    }

    private async Task ExcluirMesa(Mesa mesa)
    {
        if (await MesaService.Delete(mesa.Id))
        {
            await CarregarMesasAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pageRef == null)
        {
            _pageRef = DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _pageRef); } catch { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(NovaMesa);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleAcaoHotkey(string acao)
    {
        switch (acao)
        {
            case "salvar":
                if (modalMesa.IsOpen)
                    await modalMesa.SalvarAsync();
                break;
            case "cancelar":
                if (modalMesa.IsOpen)
                    modalMesa.Close();
                break;
            case "editar":
                if (mesaSelecionada.Id != 0)
                    await InvokeAsync(() => EditarMesa(mesaSelecionada));
                break;
            case "deletar":
                if (mesaSelecionada.Id != 0)
                    await InvokeAsync(() => ExcluirMesa(mesaSelecionada));
                break;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            if (_pageRef != null)
            {
                JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys");
                _pageRef.Dispose();
                _pageRef = null;
            }
        }
        catch { }
    }
}
