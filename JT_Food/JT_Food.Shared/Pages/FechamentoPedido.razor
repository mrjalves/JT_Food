@page "/fechamento/{ComandaId}"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.BusinessLogic

@inject ComandaService ComandaService
@inject ItemComandaService ItemComandaService
@inject AdicionaisItemComandaService AdicionaisItemComandaService
@inject PagamentoComandaService PagamentoComandaService
@inject MesaService MesaService
@inject CaixaLogic CaixaLogic

<PageTitle>Fechamento de Comanda - JT Food</PageTitle>

<div class="container-fluid py-4">
    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show" role="alert">
            @mensagemAlerta
            <button type="button" class="btn-close" @onclick="LimparAlerta"></button>
        </div>
    }

    @if (comanda == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando dados da comanda...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h2">Comanda #@comanda.Id</h1>
                            <p class="text-muted mb-0">Cliente: <strong>@comanda.NomeCliente</strong> | Mesa: <strong>@comanda.MesaId</strong></p>
                        </div>
                        <div>
                            <span class="badge @ObterClasseStatusComanda(comanda.Status) pt-2 px-3 fs-6">
                                STATUS: @comanda.Status.ToUpper()
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">V. Unit</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Status Cozinha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (itens == null || !itens.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">Nenhum item lançado.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in itens)
                                        {
                                            var adicionaisDoItem = adicionaisPorItem.GetValueOrDefault(item.Id.ToString(), new());
                                            <tr class="@(item.Status == "Cancelado" ? "text-decoration-line-through text-muted" : "")">
                                                <td>
                                                    <span class="fw-bold">@item.NomeProduto</span>
                                                    @if (!string.IsNullOrEmpty(item.Observacao))
                                                    {
                                                        <br /><small class="text-secondary"><i class="fas fa-comment-alt me-1"></i>@item.Observacao</small>
                                                    }
                                                    
                                                    @if (adicionaisDoItem.Any())
                                                    {
                                                        <div class="mt-1">
                                                        @foreach(var ad in adicionaisDoItem)
                                                        {
                                                            <small class="badge bg-info text-dark me-1">+ @ad.NomeProduto (x@ad.Quantidade)</small>
                                                        }
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-center">@item.Quantidade</td>
                                                <td class="text-end">R$ @item.PrecoUnitario.ToString("F2")</td>
                                                <td class="text-end fw-bold text-dark">
                                                    R$ @((item.TotalItem + adicionaisDoItem.Sum(a => a.TotalAdicional)).ToString("F2"))
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @KDSLogic.ObterClasseBadgeStatus(item.Status)">
                                                        @item.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-white py-3">
                        <h4 class="m-0 font-weight-bold text-primary"><i class="fas fa-calculator me-2"></i>Resumo</h4>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal Itens:</span>
                            <strong>R$ @subtotal.ToString("F2")</strong>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <span>Taxa Serviço:</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text">R$</span>
                                <input type="number" class="form-control text-end" @bind="comanda.TaxaServico" @bind:after="Recalcular" step="0.01" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-3 align-items-center">
                            <span>Desconto:</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text">R$</span>
                                <input type="number" class="form-control text-end text-danger" @bind="comanda.Desconto" @bind:after="Recalcular" step="0.01" />
                            </div>
                        </div>

                        <hr />
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fs-4">TOTAL:</span>
                            <span class="fs-3 fw-bold text-primary">R$ @comanda.Total.ToString("F2")</span>
                        </div>

                        @if (comanda.Status == "Aberta" || comanda.Status == "AguardandoPagamento")
                        {
                            <!-- Secao de Pagamentos (Rateio) -->
                            @if (pagamentosRegistrados.Any())
                            {
                                <div class="bg-light p-3 rounded mb-3 border">
                                    <h6 class="text-muted fw-bold mb-2">Pagamentos Realizados:</h6>
                                    @foreach(var pag in pagamentosRegistrados)
                                    {
                                        <div class="d-flex justify-content-between text-sm mb-1">
                                            <span>
                                            <span class="badge bg-success me-2">@pag.FormaPagamento</span>
                                            <span>R$ @pag.Valor.ToString("F2")</span>
                                            </span>
                                        </div>
                                    }
                                    <hr class="my-1"/>
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total Pago:</span>
                                        <span class="text-success">R$ @totalPago.ToString("F2")</span>
                                    </div>
                                    @if (saldoPendente > 0.01)
                                    {
                                        <div class="d-flex justify-content-between fw-bold text-danger mt-1">
                                            <span>Falta Pagar:</span>
                                            <span>R$ @saldoPendente.ToString("F2")</span>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Inserir novo pagamento -->
                            @if (saldoPendente > 0.01)
                            {
                                <div class="card bg-light border-0 mb-4">
                                    <div class="card-body p-3">
                                        <h6 class="text-dark fw-bold mb-3"><i class="fas fa-hand-holding-usd me-1"></i> Adicionar Pagamento</h6>
                                        <div class="mb-2">
                                            <select class="form-select" @bind="formaPagamentoNovo">
                                                <option value="PIX">PIX</option>
                                                <option value="CartaoCredito">Cartão de Crédito</option>
                                                <option value="CartaoDebito">Cartão de Débito</option>
                                                <option value="Dinheiro">Dinheiro</option>
                                            </select>
                                        </div>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text">R$</span>
                                            <input type="number" class="form-control text-end" @bind="valorNovoPagamento" step="0.01" min="0.01" placeholder="0,00" />
                                        </div>
                                        @if (saldoPendente > 0.01)
                                        {
                                            <div class="text-end mb-2">
                                                <button class="btn btn-sm btn-link text-decoration-none" @onclick="() => valorNovoPagamento = saldoPendente">
                                                    <i class="fas fa-magic me-1"></i> Usar saldo pendente (R$ @saldoPendente.ToString("F2"))
                                                </button>
                                            </div>
                                        }
                                        <button class="btn btn-outline-success w-100" @onclick="AdicionarPagamentoAsync">
                                            <i class="fas fa-plus me-1"></i> Registrar Parcela
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Botoes de Acao Final -->
                            @if (comanda.Status == "Aberta")
                            {
                                <button class="btn btn-warning w-100 mb-2 fw-bold" @onclick="SolicitarFechamentoAsync">
                                    <i class="fas fa-file-invoice-dollar me-2"></i> Solicitar Fechamento da Mesa
                                </button>
                            }

                            <!-- Botao de Confirmar Quitacao -->
                            <button class="btn btn-success w-100 py-3 fw-bold fs-5"
                                    @onclick="ConfirmarQuitacaoAsync"
                                    disabled="@(saldoPendente > 0.01)">
                                <i class="fas fa-check-circle me-2"></i>
                                @(saldoPendente > 0.01 ? $"Faltam R$ {saldoPendente:F2}" : "CONFIRMAR QUITAÇÃO")
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-secondary text-center">
                                <i class="fas fa-lock mb-2 fa-2x"></i>
                                <h5>Comanda Fechada</h5>
                                <p class="mb-0">Este pedido já foi encerrado e contabilizado no caixa.</p>
                                @if (pagamentosRegistrados.Any())
                                {
                                    <hr class="my-2" />
                                    <small class="text-muted">Pago em @pagamentosRegistrados.Count parcela(s) — Total: R$ @totalPago.ToString("F2")</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string ComandaId { get; set; } = string.Empty;

    private Comanda? comanda;
    private List<MItemComanda> itens = new();
    private Dictionary<string, List<MAdicionaisItemComanda>> adicionaisPorItem = new();
    private List<MPagamentoComanda> pagamentosRegistrados = new();

    private double subtotal = 0;
    private double totalPago = 0;
    private double saldoPendente = 0;

    private string formaPagamentoNovo = "PIX";
    private double valorNovoPagamento = 0;

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";

    private string CurrentUserId = "1"; // Mocked user

    protected override async Task OnInitializedAsync()
    {
        await CarregarComandaAsync();
    }

    private async Task CarregarComandaAsync()
    {
        if (int.TryParse(ComandaId, out int id))
        {
            comanda = await ComandaService.GetById(id);
            if (comanda != null)
            {
                itens = await ItemComandaService.Find($"ComandaId = '{comanda.Id}'");

                // Carregar adicionais de cada item
                adicionaisPorItem = new();
                foreach (var item in itens)
                {
                    var ads = await AdicionaisItemComandaService.Find($"ItemComandaId = '{item.Id}'");
                    if (ads != null && ads.Any())
                        adicionaisPorItem[item.Id.ToString()] = ads;
                }

                // Carregar pagamentos já registrados
                var pags = await PagamentoComandaService.Find($"ComandaId = '{comanda.Id}'");
                pagamentosRegistrados = pags ?? new();

                await RecalcularAsync();
            }
            else
            {
                ExibirAlerta("Comanda não encontrada.", "alert-danger");
            }
        }
    }

    private async Task RecalcularAsync()
    {
        if (comanda == null) return;

        subtotal = itens
            .Where(x => x.Status != "Cancelado")
            .Sum(x =>
            {
                var ads = adicionaisPorItem.GetValueOrDefault(x.Id.ToString(), new());
                return x.TotalItem + ads.Sum(a => a.TotalAdicional);
            });

        comanda.Total = subtotal + comanda.TaxaServico - comanda.Desconto;
        if (comanda.Total < 0) comanda.Total = 0;

        var verificacao = await CaixaLogic.VerificarComandaQuitadaAsync(comanda.Id.ToString(), comanda.Total);
        totalPago = verificacao.TotalPago;
        saldoPendente = verificacao.SaldoPendente;
        StateHasChanged();
    }

    private void Recalcular()
    {
        _ = RecalcularAsync();
    }

    private async Task AdicionarPagamentoAsync()
    {
        LimparAlerta();

        if (valorNovoPagamento <= 0)
        {
            ExibirAlerta("Informe um valor maior que zero.", "alert-warning");
            return;
        }
        if (comanda == null) return;

        var result = await CaixaLogic.RegistrarPagamentoParcialAsync(
            comanda.Id.ToString(),
            formaPagamentoNovo,
            valorNovoPagamento,
            CurrentUserId
        );

        if (result.Sucesso)
        {
            ExibirAlerta(result.Mensagem, "alert-success");
            valorNovoPagamento = 0;
            pagamentosRegistrados = await PagamentoComandaService.Find($"ComandaId = '{comanda.Id}'") ?? new();
            await RecalcularAsync();
        }
        else
        {
            ExibirAlerta(result.Mensagem, "alert-danger");
        }
    }

    private async Task SolicitarFechamentoAsync()
    {
        LimparAlerta();
        if (comanda == null || comanda.Status != "Aberta") return;

        comanda.Status = "AguardandoPagamento";
        await ComandaService.SaveAsync(comanda);

        await AtualizarStatusMesaAsync(StatusMesa.AguardandoPagamento);

        ExibirAlerta("Mesa marcada como 'Aguardando Pagamento'. Registre os pagamentos abaixo.", "alert-info");
    }

    private async Task ConfirmarQuitacaoAsync()
    {
        LimparAlerta();

        if (comanda == null) return;
        if (saldoPendente > 0.01)
        {
            ExibirAlerta($"Saldo pendente de R$ {saldoPendente:F2}. Registre o pagamento restante.", "alert-danger");
            return;
        }

        comanda.Status = "Fechada";
        comanda.DataFechamento = DateTime.UtcNow;
        bool salvo = await ComandaService.SaveAsync(comanda) > 0;

        if (salvo)
        {
            await AtualizarStatusMesaAsync(StatusMesa.Livre);
            ExibirAlerta("Comanda quitada e fechada com sucesso! Mesa liberada.", "alert-success");
        }
        else
        {
            comanda.Status = "AguardandoPagamento"; 
            ExibirAlerta("Erro ao registrar o fechamento.", "alert-danger");
        }
    }

    private async Task AtualizarStatusMesaAsync(string novoStatus)
    {
        if (comanda == null || string.IsNullOrEmpty(comanda.MesaId)) return;
        var mesas = await MesaService.Find($"Identificacao = '{comanda.MesaId}'");
        var mesa = mesas?.FirstOrDefault();
        if (mesa != null)
        {
            mesa.Status = novoStatus;
            await MesaService.SaveAsync(mesa);
        }
    }

    private string ObterClasseStatusComanda(string status) => status switch
    {
        "Aberta" => "bg-success",
        "AguardandoPagamento" => "bg-warning text-dark",
        "Fechada" => "bg-secondary",
        "Cancelada" => "bg-danger",
        _ => "bg-secondary"
    };

    private void ExibirAlerta(string mensagem, string classe)
    {
        mensagemAlerta = mensagem;
        classeAlerta = classe;
    }

    private void LimparAlerta()
    {
        mensagemAlerta = "";
    }
}
