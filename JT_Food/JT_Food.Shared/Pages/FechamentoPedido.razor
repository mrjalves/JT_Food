@page "/fechamento/{ComandaId}"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Domain.Enums
@using JT_Food.Shared.Services.Interfaces

@inject ComandaService ComandaService
@inject IComandaService ComandaOperacionalService
@inject ItemComandaService ItemComandaService
@inject AdicionaisItemComandaService AdicionaisItemComandaService
@inject PagamentoComandaService PagamentoComandaService
@inject MesaService MesaService
@inject CaixaLogic CaixaLogic
@inject IImpressaoRedeService ImpressaoService
@inject NavigationManager Navigation

<PageTitle>Fechamento de Conta - JT Food</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-3">
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick='() => Navigation.NavigateTo("/comandas")'>
            <i class="bi bi-arrow-left me-1"></i> Voltar para Comandas
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@mensagemAlerta
            <button type="button" class="btn-close" @onclick="LimparAlerta"></button>
        </div>
    }

    @if (comanda == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando detalhes da comanda...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Coluna Esquerda: Itens do Pedido -->
            <div class="col-lg-7">
                <div class="card shadow-sm border" data-tutorial="fechamento-itens">
                    <div class="card-header border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2" data-tutorial="fechamento-header">
                        <div>
                            <h2 class="h4 mb-0 fw-bold">
                                Comanda #@comanda.Id — @(string.IsNullOrWhiteSpace(comanda.NomeCliente) ? "Consumidor" : comanda.NomeCliente)
                            </h2>
                            <small class="text-muted">
                                @(string.IsNullOrEmpty(comanda.MesaId) ? "Balcão / Sem Mesa" : $"Mesa: {comanda.MesaId}") | Abertura: @comanda.DataAbertura.ToString("dd/MM HH:mm")
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (itens.Any())
                            {
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="SelecionarTodos" title="Selecionar todos os itens da comanda">
                                        <i class="bi bi-check-all me-1"></i> Todos (@(itens.Count(i => i.Status != "Cancelado")))
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="DesmarcarTodos" title="Desmarcar todos">
                                        <i class="bi bi-x me-1"></i> Limpar
                                    </button>
                                </div>
                            }
                            <span class="badge @ObterClasseStatusComanda(comanda.Status) px-3 py-2 fs-6">
                                @comanda.Status.ToUpper()
                            </span>
                        </div>
                    </div>

                    @if (comandasConsolidadas.Count > 1)
                    {
                        <div class="alert alert-info border-info-subtle bg-info-subtle text-info-emphasis d-flex align-items-center mb-0 rounded-0 border-start-0 border-end-0 py-2.5 px-3">
                            <i class="bi bi-collection-fill text-primary fs-5 me-2.5"></i>
                            <div class="small">
                                <strong>Consolidando @comandasConsolidadas.Count comandas abertas</strong> para @(string.IsNullOrWhiteSpace(comanda.NomeCliente) ? "este cliente" : comanda.NomeCliente)
                                (Comandas: @string.Join(", ", comandasConsolidadas.Select(c => $"#{c.Id}"))).
                                <span class="ms-1 opacity-75">Todos os itens consumidos foram reunidos nesta tela para seleção e fechamento.</span>
                            </div>
                        </div>
                    }

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="border-bottom bg-body-tertiary">
                                    <tr>
                                        <th style="width: 44px;" class="text-center">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@(itens.Any(i => i.Status != "Cancelado") && itensSelecionadosIds.Count == itens.Count(i => i.Status != "Cancelado"))"
                                                   @onchange="ToggleSelecionarTodos"
                                                   title="Selecionar / Desmarcar Todos" />
                                        </th>
                                        <th>Item Consumido</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">V. Unit</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">KDS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!itens.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="bi bi-cart-x fs-3 d-block mb-2 opacity-50"></i>
                                                <span class="d-block fw-semibold">Nenhum item consumido registrado para esta comanda.</span>
                                                <small class="text-muted d-block mt-1">Lançamentos de pedidos podem ser feitos no Mapa de Mesas ou na listagem de Comandas.</small>
                                                <button class="btn btn-sm btn-outline-primary mt-3 rounded-pill px-3" @onclick='() => Navigation.NavigateTo("/comandas")'>
                                                    <i class="bi bi-cart-plus me-1"></i> Ir para Lançamento de Pedidos
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in itens)
                                        {
                                            var adicionaisDoItem = adicionaisPorItem.GetValueOrDefault(item.Id.ToString(), new());
                                            bool isCancelado = item.Status == "Cancelado";
                                            bool isSelected = itensSelecionadosIds.Contains(item.Id);
                                            <tr class="@(isCancelado ? "text-decoration-line-through text-muted" : (!isSelected ? "opacity-50" : ""))">
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@isSelected"
                                                           disabled="@isCancelado"
                                                           @onchange="(e) => ToggleItem(item.Id, (bool)(e.Value ?? false))" />
                                                </td>
                                                <td>
                                                    @if (comandasConsolidadas.Count > 1 && !string.IsNullOrEmpty(item.ComandaId))
                                                    {
                                                        <span class="badge bg-secondary-subtle text-body border border-secondary-subtle me-1 font-monospace small" title="Comanda de origem">#@item.ComandaId.TrimStart('#')</span>
                                                    }
                                                    <span class="fw-semibold @(isSelected ? "" : "text-muted")">@item.NomeProduto</span>
                                                    @if (!string.IsNullOrEmpty(item.Observacao))
                                                    {
                                                        <br /><small class="text-secondary"><i class="bi bi-chat-left-text me-1"></i>@item.Observacao</small>
                                                    }
                                                    @if (adicionaisDoItem.Any())
                                                    {
                                                        <div class="mt-1">
                                                            @foreach (var ad in adicionaisDoItem)
                                                            {
                                                                <small class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-1">+ @ad.NomeProduto (x@ad.Quantidade)</small>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-center">@item.Quantidade</td>
                                                <td class="text-end">R$ @item.PrecoUnitario.ToString("F2")</td>
                                                <td class="text-end fw-bold @(isSelected ? "" : "text-muted")">
                                                    R$ @((item.TotalItem + adicionaisDoItem.Sum(a => a.TotalAdicional)).ToString("F2"))
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @KDSLogic.ObterClasseBadgeStatus(item.Status)">
                                                        @item.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary px-3 py-2">
                                <i class="bi bi-check2-square me-1"></i> @itensSelecionadosIds.Count de @(itens.Count(i => i.Status != "Cancelado")) itens selecionados
                            </span>
                            <span class="small text-muted">
                                Subtotal selecionado: <strong>R$ @subtotal.ToString("F2")</strong>
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ImprimirPreContaAsync">
                                <i class="bi bi-printer me-1"></i> Imprimir Pré-Conta ESC/POS
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick='() => Navigation.NavigateTo("/comandas")'>
                                <i class="bi bi-arrow-left me-1"></i> Voltar para Comandas
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Coluna Direita: Resumo Financeiro, Couvert, Taxa e Divisão de Conta -->
            <div class="col-lg-5">
                <div class="card shadow-sm border mb-4" data-tutorial="fechamento-totais">
                    <div class="card-header border-bottom py-3">
                        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-calculator me-2"></i>Fechamento e Totais</h5>
                    </div>
                    <div class="card-body">
                        <!-- Subtotal Itens -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal de Consumo:</span>
                            <strong class="fs-6">R$ @subtotal.ToString("F2")</strong>
                        </div>

                        <!-- Couvert Artístico -->
                        <div class="card bg-body-secondary border border-secondary-subtle p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="checkCouvertFechamento"
                                           checked="@cobrarCouvert"
                                           @onchange="ToggleCouvert" />
                                    <label class="form-check-label fw-bold small" for="checkCouvertFechamento">
                                        🎵 Couvert Artístico
                                    </label>
                                </div>
                                @if (cobrarCouvert)
                                {
                                    <button class="btn btn-sm btn-link text-danger text-decoration-none p-0" @onclick="IsentarCouvert">
                                        (Isentar)
                                    </button>
                                }
                            </div>
                            @if (cobrarCouvert)
                            {
                                <div class="row g-2 align-items-center mt-1">
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">Pessoas</span>
                                            <input type="number" class="form-control text-center" @bind="quantidadePessoas" @bind:after="Recalcular" min="1" max="50" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">R$</span>
                                            <input type="number" class="form-control text-end" @bind="valorCouvertUnitario" @bind:after="Recalcular" step="1.00" />
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end mt-1">
                                    <small class="text-muted">Total Couvert: <strong>R$ @valorCouvertTotal.ToString("F2")</strong></small>
                                </div>
                            }
                        </div>

                        <!-- Taxa de Serviço (10%) -->
                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="checkServico"
                                       checked="@cobrarServico"
                                       @onchange="ToggleServico" />
                                <label class="form-check-label text-muted small" for="checkServico">
                                    Taxa Serviço (10%):
                                </label>
                            </div>
                            <strong>R$ @valorServico.ToString("F2")</strong>
                        </div>

                        <!-- Desconto -->
                        <div class="d-flex justify-content-between mb-3 align-items-center">
                            <span class="text-muted small">Desconto (R$):</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text">R$</span>
                                <input type="number" class="form-control text-end text-danger fw-bold" @bind="desconto" @bind:after="Recalcular" step="1.00" />
                            </div>
                        </div>

                        <hr />

                        <!-- TOTAL FINAL -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-5 fw-bold">TOTAL FINAL:</span>
                            <span class="fs-3 fw-bold text-success">R$ @totalFinal.ToString("F2")</span>
                        </div>

                        <!-- Divisão por Pagantes / Pessoas -->
                        @if (quantidadePessoas > 1)
                        {
                            <div class="p-2 mb-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-people-fill text-primary me-2"></i>
                                    <span class="fw-semibold">Divisão por Pagante:</span>
                                    <small class="d-block text-muted">Dividido igualmente entre @quantidadePessoas pessoas</small>
                                </div>
                                <span class="fs-5 fw-bold text-primary">R$ @(valorPorPessoa.ToString("F2")) / pes.</span>
                            </div>
                        }

                        <!-- SEÇÃO DE PAGAMENTOS -->
                        @if (comanda.Status == "Aberta" || comanda.Status == "AguardandoPagamento")
                        {
                            @if (pagamentosRegistrados.Any())
                            {
                                <div class="bg-body-secondary p-3 rounded mb-3 border border-secondary-subtle">
                                    <h6 class="text-muted fw-bold mb-2">Pagamentos Lançados:</h6>
                                    @foreach (var pag in pagamentosRegistrados)
                                    {
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span>
                                                <span class="badge bg-secondary me-2">@pag.FormaPagamento</span>
                                                <span>R$ @pag.Valor.ToString("F2")</span>
                                            </span>
                                            <span class="text-muted">@pag.DataHora.ToString("HH:mm")</span>
                                        </div>
                                    }
                                    <hr class="my-1" />
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total Já Pago:</span>
                                        <span class="text-success">R$ @totalPago.ToString("F2")</span>
                                    </div>
                                    @if (saldoPendente > 0.01)
                                    {
                                        <div class="d-flex justify-content-between fw-bold text-danger mt-1">
                                            <span>Falta Pagar:</span>
                                            <span>R$ @saldoPendente.ToString("F2")</span>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Inserir Parcela de Pagamento -->
                            @if (saldoPendente > 0.01)
                            {
                                <div class="card bg-body-secondary border border-secondary-subtle mb-3" data-tutorial="fechamento-pagamentos">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold mb-2">
                                            <i class="bi bi-wallet2 me-1"></i> Registrar Pagamento
                                        </h6>
                                        <div class="row g-2 mb-2">
                                            <div class="col-7">
                                                <select class="form-select form-select-sm" @bind="formaPagamentoNovo">
                                                    <option value="PIX">⚡ PIX</option>
                                                    <option value="Cartão de Crédito">💳 Cartão de Crédito</option>
                                                    <option value="Cartão de Débito">💳 Cartão de Débito</option>
                                                    <option value="Dinheiro">💵 Dinheiro</option>
                                                </select>
                                            </div>
                                            <div class="col-5">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">R$</span>
                                                    <input type="number" class="form-control text-end fw-bold" @bind="valorNovoPagamento" step="0.50" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="() => valorNovoPagamento = saldoPendente">
                                                Usar saldo restante (R$ @saldoPendente.ToString("F2"))
                                            </button>
                                            @if (quantidadePessoas > 1)
                                            {
                                                <button class="btn btn-sm btn-link text-decoration-none p-0 text-primary" @onclick="() => valorNovoPagamento = Math.Min(saldoPendente, valorPorPessoa)">
                                                    1 Parcela (R$ @valorPorPessoa.ToString("F2"))
                                                </button>
                                            }
                                        </div>

                                        <button class="btn btn-sm btn-outline-success w-100 fw-bold" @onclick="AdicionarPagamentoAsync">
                                            <i class="bi bi-plus-lg me-1"></i> Confirmar Parcela de Pagamento
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Botões Finais de Ação -->
                            <button class="btn btn-success w-100 py-3 fw-bold fs-5 shadow-sm"
                                    data-tutorial="fechamento-finalizar"
                                    @onclick="ConfirmarQuitacaoELiberarAsync"
                                    disabled="@(saldoPendente > 0.01 || quitando)">
                                @if (quitando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Encerrando Conta...</span>
                                }
                                else if (saldoPendente > 0.01)
                                {
                                    <i class="bi bi-lock me-2"></i>
                                    <span>Faltam R$ @saldoPendente.ToString("F2")</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-2"></i>
                                    <span>QUITAR & LIBERAR MESA</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-secondary text-center py-4">
                                <i class="bi bi-check-circle-fill fs-2 d-block mb-2 text-success"></i>
                                <h6 class="fw-bold mb-1">Comanda Quitada e Encerrada</h6>
                                <p class="text-muted small mb-3">A comanda já foi baixada no caixa e a mesa liberada.</p>
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick='() => Navigation.NavigateTo("/comandas")'>
                                    <i class="bi bi-arrow-left me-1"></i> Voltar para Comandas
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string ComandaId { get; set; } = string.Empty;

    private JT_Classes.Restaurante.Comanda? comanda;
    private List<JT_Classes.Restaurante.Comanda> comandasConsolidadas = new();
    private List<MItemComanda> itens = new();
    private HashSet<int> itensSelecionadosIds = new();
    private Dictionary<string, List<MAdicionaisItemComanda>> adicionaisPorItem = new();
    private List<MPagamentoComanda> pagamentosRegistrados = new();

    private double subtotal = 0;
    private bool cobrarCouvert = false;
    private int quantidadePessoas = 1;
    private double valorCouvertUnitario = 15.00;
    private double valorCouvertTotal => cobrarCouvert ? (valorCouvertUnitario * quantidadePessoas) : 0;

    private bool cobrarServico = true;
    private double valorServico => cobrarServico ? Math.Round(subtotal * 0.10, 2) : 0;

    private double desconto = 0;
    private double totalFinal => Math.Max(0, subtotal + valorCouvertTotal + valorServico - desconto);
    private double valorPorPessoa => totalFinal / Math.Max(1, quantidadePessoas);

    private double totalPago = 0;
    private double saldoPendente = 0;

    private string formaPagamentoNovo = "PIX";
    private double valorNovoPagamento = 0;
    private bool quitando = false;

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await CarregarComandaAsync();
    }

    private async Task CarregarComandaAsync()
    {
        if (int.TryParse(ComandaId, out int id))
        {
            comanda = await ComandaService.GetById(id);
            if (comanda != null)
            {
                // Obter todas as comandas irmãs abertas (do mesmo cartão ou da mesma mesa)
                try
                {
                    comandasConsolidadas = await ComandaOperacionalService.ObterComandasIrmasAsync(id);
                }
                catch
                {
                    comandasConsolidadas = new List<JT_Classes.Restaurante.Comanda>();
                }

                if (!comandasConsolidadas.Any(c => c.Id == comanda.Id))
                {
                    comandasConsolidadas.Insert(0, comanda);
                }

                var idsValidos = comandasConsolidadas.Select(c => c.Id.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);
                foreach (var cid in idsValidos.ToList())
                {
                    idsValidos.Add($"#{cid}");
                }

                if (!string.IsNullOrWhiteSpace(comanda.MesaId))
                {
                    idsValidos.Add(comanda.MesaId);
                    string mesaNorm = comanda.MesaId.Replace("Mesa ", "").Trim();
                    idsValidos.Add(mesaNorm);
                    idsValidos.Add($"Mesa {mesaNorm}");
                }

                var allItens = await ItemComandaService.GetAll();
                itens = (allItens ?? Enumerable.Empty<MItemComanda>())
                    .Where(i => !string.IsNullOrWhiteSpace(i.ComandaId) &&
                                (idsValidos.Contains(i.ComandaId) || idsValidos.Contains(i.ComandaId.Trim().TrimStart('#'))))
                    .OrderBy(i => i.Id)
                    .ToList();

                var allAds = await AdicionaisItemComandaService.GetAll();
                var itemIds = itens.Select(i => i.Id.ToString()).ToHashSet();
                if (allAds != null)
                {
                    foreach (var group in allAds.Where(a => itemIds.Contains(a.ItemComandaId)).GroupBy(a => a.ItemComandaId))
                    {
                        adicionaisPorItem[group.Key] = group.ToList();
                    }
                }

                var allPagamentos = await PagamentoComandaService.GetAll();
                pagamentosRegistrados = (allPagamentos ?? Enumerable.Empty<MPagamentoComanda>())
                    .Where(p => !string.IsNullOrWhiteSpace(p.ComandaId) &&
                                (idsValidos.Contains(p.ComandaId) || idsValidos.Contains(p.ComandaId.Trim().TrimStart('#'))))
                    .ToList();

                // Couvert: se alguma das comandas consolidadas tiver couvert registrado
                double totalCouvertRegistrado = comandasConsolidadas.Sum(c => c.TaxaServico);
                if (totalCouvertRegistrado > 0)
                {
                    cobrarCouvert = true;
                    valorCouvertUnitario = 15.00;
                    quantidadePessoas = Math.Max(1, (int)Math.Round(totalCouvertRegistrado / 15.00));
                }
                else
                {
                    cobrarCouvert = false;
                }

                // Se não há nenhum item lançado individualmente em nenhuma das comandas irmãs, mas há total acumulado
                double somaTotalComandas = comandasConsolidadas.Sum(c => c.Total);
                if (!itens.Any() && somaTotalComandas > 0)
                {
                    double saldoConsumo = somaTotalComandas - (cobrarCouvert ? valorCouvertTotal : 0);
                    if (saldoConsumo > 0.01)
                    {
                        itens.Add(new MItemComanda
                        {
                            Id = 999000 + comanda.Id,
                            ComandaId = comanda.Id.ToString(),
                            NomeProduto = $"Consumo Registrado ({comanda.NomeCliente ?? "Comanda #" + comanda.Id})",
                            Quantidade = 1,
                            PrecoUnitario = saldoConsumo,
                            TotalItem = saldoConsumo,
                            Status = "Confirmado",
                            Observacao = "Consumo acumulado na comanda"
                        });
                    }
                }

                // Por padrão, todos os itens ativos vêm selecionados
                itensSelecionadosIds = itens.Where(i => i.Status != "Cancelado").Select(i => i.Id).ToHashSet();

                desconto = comandasConsolidadas.Sum(c => c.Desconto);

                Recalcular();
            }
        }
    }

    private void ToggleItem(int itemId, bool selecionado)
    {
        if (selecionado)
        {
            itensSelecionadosIds.Add(itemId);
        }
        else
        {
            itensSelecionadosIds.Remove(itemId);
        }
        Recalcular();
    }

    private void ToggleSelecionarTodos(ChangeEventArgs e)
    {
        bool marcar = (bool)(e.Value ?? false);
        if (marcar)
        {
            SelecionarTodos();
        }
        else
        {
            DesmarcarTodos();
        }
    }

    private void SelecionarTodos()
    {
        itensSelecionadosIds = itens.Where(i => i.Status != "Cancelado").Select(i => i.Id).ToHashSet();
        Recalcular();
    }

    private void DesmarcarTodos()
    {
        itensSelecionadosIds.Clear();
        Recalcular();
    }

    private void ToggleCouvert(ChangeEventArgs e)
    {
        cobrarCouvert = (bool)(e.Value ?? false);
        Recalcular();
    }

    private void IsentarCouvert()
    {
        cobrarCouvert = false;
        Recalcular();
    }

    private void ToggleServico(ChangeEventArgs e)
    {
        cobrarServico = (bool)(e.Value ?? false);
        Recalcular();
    }

    private void Recalcular()
    {
        if (comanda == null) return;

        double somaItens = itens
            .Where(x => x.Status != "Cancelado" && itensSelecionadosIds.Contains(x.Id))
            .Sum(x =>
            {
                var ads = adicionaisPorItem.GetValueOrDefault(x.Id.ToString(), new());
                return x.TotalItem + ads.Sum(a => a.TotalAdicional);
            });

        subtotal = somaItens;

        comanda.TaxaServico = valorCouvertTotal + valorServico;
        comanda.Desconto = desconto;
        comanda.Total = totalFinal;

        totalPago = pagamentosRegistrados.Sum(p => p.Valor);
        saldoPendente = Math.Max(0, totalFinal - totalPago);

        if (valorNovoPagamento == 0 || valorNovoPagamento > saldoPendente)
        {
            valorNovoPagamento = saldoPendente;
        }

        StateHasChanged();
    }

    private async Task AdicionarPagamentoAsync()
    {
        LimparAlerta();
        if (valorNovoPagamento <= 0)
        {
            ExibirAlerta("Informe um valor de pagamento maior que zero.", "alert-warning");
            return;
        }
        if (comanda == null) return;

        var result = await CaixaLogic.RegistrarPagamentoParcialAsync(
            comanda.Id.ToString(),
            formaPagamentoNovo,
            valorNovoPagamento,
            "1",
            $"Pagamento ({formaPagamentoNovo}) - {comanda.NomeCliente}"
        );

        if (result.Sucesso)
        {
            valorNovoPagamento = 0;
            var idsValidos = comandasConsolidadas.Select(c => c.Id.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var allPagamentos = await PagamentoComandaService.GetAll();
            pagamentosRegistrados = (allPagamentos ?? Enumerable.Empty<MPagamentoComanda>())
                .Where(p => !string.IsNullOrWhiteSpace(p.ComandaId) &&
                            (idsValidos.Contains(p.ComandaId) || idsValidos.Contains(p.ComandaId.Trim().TrimStart('#'))))
                .ToList();
            Recalcular();

            if (saldoPendente <= 0.01)
            {
                await ConfirmarQuitacaoELiberarAsync();
            }
            else
            {
                ExibirAlerta(result.Mensagem, "alert-success");
            }
        }
        else
        {
            ExibirAlerta(result.Mensagem, "alert-danger");
        }
    }

    private async Task ConfirmarQuitacaoELiberarAsync()
    {
        LimparAlerta();
        if (comanda == null) return;

        if (saldoPendente > 0.01)
        {
            ExibirAlerta($"Ainda restam R$ {saldoPendente:F2} pendentes para quitação.", "alert-danger");
            return;
        }

        quitando = true;

        // Salva e quita todas as comandas irmãs consolidadas
        foreach (var c in comandasConsolidadas)
        {
            c.Status = "Fechada";
            c.DataFechamento = DateTime.UtcNow;
            await ComandaService.SaveAsync(c);
            await CaixaLogic.FinalizarComandaELiberarMesaAsync(c.Id);
        }

        quitando = false;
        comanda.Status = "Fechada";
        ExibirAlerta("Comanda quitada com sucesso! Redirecionando para a lista de comandas...", "alert-success");
        StateHasChanged();
        await Task.Delay(1200);
        Navigation.NavigateTo("/comandas");
    }

    private async Task ImprimirPreContaAsync()
    {
        if (comanda == null) return;

        var itensParaImpressao = itens
            .Where(i => i.Status != "Cancelado" && (itensSelecionadosIds.Count == 0 || itensSelecionadosIds.Contains(i.Id)))
            .Select(i => new ItemPedido
            {
                NomeProduto = i.NomeProduto ?? "",
                Quantidade = i.Quantidade,
                PrecoUnitario = i.PrecoUnitario
            }).ToList();

        var domainCmd = new JT_Food.Shared.Domain.Entities.Comanda
        {
            Id = comanda.Id,
            NomeCliente = comanda.NomeCliente,
            MesaId = comanda.MesaId,
            DataAbertura = comanda.DataAbertura,
            Subtotal = subtotal,
            PossuiCouvert = cobrarCouvert,
            ValorCouvert = valorCouvertUnitario,
            QuantidadePessoas = quantidadePessoas,
            TaxaServico = valorServico,
            Desconto = desconto,
            Itens = itensParaImpressao
        };

        var res = await ImpressaoService.ImprimirContaAsync(domainCmd);
        if (res.Sucesso)
        {
            ExibirAlerta("Pré-conta enviada para a impressora do Caixa!", "alert-success");
        }
        else
        {
            ExibirAlerta(res.Mensagem, "alert-warning");
        }
    }

    private string ObterClasseStatusComanda(string status) => status switch
    {
        "Aberta" => "bg-success",
        "AguardandoPagamento" => "bg-warning text-dark",
        "Fechada" => "bg-secondary",
        _ => "bg-secondary"
    };

    private void ExibirAlerta(string msg, string classe)
    {
        mensagemAlerta = msg;
        classeAlerta = classe;
    }

    private void LimparAlerta() => mensagemAlerta = "";
}
