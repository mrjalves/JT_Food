@page "/fechamento/{ComandaId}"
@using JT_Food.Shared.Models
@using JT_Food.Shared.Services
@using JT_Food.Shared.BusinessLogic

<PageTitle>Fechamento de Conta - JT Food</PageTitle>

<div class="container-fluid py-4">
    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show" role="alert">
            @mensagemAlerta
            <button type="button" class="btn-close" @onclick="LimparAlerta"></button>
        </div>
    }

    @if (comanda == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando dados da comanda...</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <div>
                <h1 class="h2">Comanda #@comanda.Id</h1>
                <p class="text-muted mb-0">Cliente: <strong>@comanda.NomeCliente</strong> | Mesa: <strong>@comanda.MesaId</strong></p>
            </div>
            <div class="btn-toolbar mb-2 mb-md-0">
                <span class="badge @ObterClasseStatusComanda(comanda.Status) pt-2 px-3 fs-6">
                    STATUS: @comanda.Status.ToUpper()
                </span>
            </div>
        </div>

        <div class="row">
            <!-- Revisão de Itens com Adicionais -->
            <div class="col-md-7 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-list-ol text-primary me-2"></i> Revisão de Itens</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item / Adicionais</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">V. Unit</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">KDS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (itens == null || !itens.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">Nenhum item lançado.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in itens)
                                        {
                                            var adicionaisDoItem = adicionaisPorItem.GetValueOrDefault(item.Id.ToString(), new());
                                            <tr class="@(item.Status == "Cancelado" ? "text-decoration-line-through text-muted" : "")">
                                                <td>
                                                    <span class="fw-bold">@item.NomeProduto</span>
                                                    @if (!string.IsNullOrEmpty(item.Observacao))
                                                    {
                                                        <br /><small class="text-secondary"><i class="fas fa-comment-alt me-1"></i>@item.Observacao</small>
                                                    }
                                                    @if (adicionaisDoItem.Any())
                                                    {
                                                        <br />
                                                        @foreach (var ad in adicionaisDoItem)
                                                        {
                                                            <small class="badge bg-info text-dark me-1">+ @ad.NomeProduto (x@ad.Quantidade)</small>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-center">@item.Quantidade</td>
                                                <td class="text-end">R$ @item.PrecoUnitario.ToString("F2")</td>
                                                <td class="text-end fw-bold">
                                                    R$ @((item.TotalItem + adicionaisDoItem.Sum(a => a.TotalAdicional)).ToString("F2"))
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @KDSLogic.ObterClasseBadgeStatus(item.Status)">
                                                        @item.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagamento e Resumo Financeiro -->
            <div class="col-md-5 mb-4">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-calculator me-2"></i> Resumo Financeiro</h5>
                    </div>
                    <div class="card-body bg-light">
                        <!-- Totais -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (Itens + Adicionais):</span>
                            <strong>R$ @subtotal.ToString("F2")</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Taxa de Serviço:</span>
                            <div class="input-group input-group-sm w-50">
                                <input type="number" class="form-control text-end" @bind="comanda.TaxaServico" @bind:after="Recalcular" step="0.01" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-danger">Desconto:</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text bg-white text-danger">- R$</span>
                                <input type="number" class="form-control text-end text-danger" @bind="comanda.Desconto" @bind:after="Recalcular" step="0.01" />
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-5">TOTAL A PAGAR:</span>
                            <span class="fs-3 fw-bold text-primary">R$ @comanda.Total.ToString("F2")</span>
                        </div>

                        @if (comanda.Status == "Aberta" || comanda.Status == "AguardandoPagamento")
                        {
                            <!-- Pagamentos já lançados -->
                            @if (pagamentosRegistrados.Any())
                            {
                                <div class="mb-3">
                                    <h6 class="text-muted mb-2"><i class="fas fa-receipt me-1"></i> Pagamentos Recebidos</h6>
                                    @foreach (var pag in pagamentosRegistrados)
                                    {
                                        <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                            <span class="badge bg-success me-2">@pag.FormaPagamento</span>
                                            <span>R$ @pag.Valor.ToString("F2")</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between fw-bold mt-2">
                                        <span class="text-success">Total Pago:</span>
                                        <span class="text-success">R$ @totalPago.ToString("F2")</span>
                                    </div>
                                    @if (saldoPendente > 0.01)
                                    {
                                        <div class="d-flex justify-content-between fw-bold text-danger">
                                            <span>Saldo Pendente:</span>
                                            <span>R$ @saldoPendente.ToString("F2")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-success py-1 mt-2 text-center small">
                                            <i class="fas fa-check-circle me-1"></i> Conta quitada!
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Formulário para novo pagamento parcial -->
                            <div class="bg-white p-3 rounded border mb-3">
                                <h6 class="text-muted mb-3"><i class="fas fa-wallet me-2"></i> Adicionar Pagamento</h6>
                                <div class="mb-2">
                                    <label class="form-label small">Forma de Pagamento</label>
                                    <select class="form-select form-select-sm" @bind="formaPagamentoNovo">
                                        <option value="Dinheiro">Dinheiro</option>
                                        <option value="CartaoCredito">Cartão de Crédito</option>
                                        <option value="CartaoDebito">Cartão de Débito</option>
                                        <option value="PIX">PIX</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Valor (R$)</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">R$</span>
                                        <input type="number" class="form-control text-end" @bind="valorNovoPagamento" step="0.01" min="0.01" placeholder="0,00" />
                                    </div>
                                    @if (saldoPendente > 0.01)
                                    {
                                        <div class="mt-1">
                                            <a class="text-decoration-none small" href="#" @onclick:preventDefault @onclick="() => valorNovoPagamento = saldoPendente">
                                                <i class="fas fa-magic me-1"></i> Usar saldo pendente (R$ @saldoPendente.ToString("F2"))
                                            </a>
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-outline-primary w-100" @onclick="AdicionarPagamento">
                                    <i class="fas fa-plus me-1"></i> Adicionar Pagamento
                                </button>
                            </div>

                            <!-- Botão de Solicitar Fechamento (muda mesa para AguardandoPagamento) -->
                            @if (comanda.Status == "Aberta")
                            {
                                <button class="btn btn-warning w-100 mb-2 fw-bold" @onclick="SolicitarFechamento">
                                    <i class="fas fa-file-invoice-dollar me-2"></i> Solicitar Fechamento da Mesa
                                </button>
                            }

                            <!-- Botão de Confirmar Quitação — habilitado só quando conta quitada -->
                            <button class="btn btn-success w-100 py-3 fw-bold fs-5"
                                    @onclick="ConfirmarQuitacao"
                                    disabled="@(saldoPendente > 0.01)">
                                <i class="fas fa-check-circle me-2"></i>
                                @(saldoPendente > 0.01 ? $"Faltam R$ {saldoPendente:F2}" : "CONFIRMAR QUITAÇÃO")
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-secondary text-center">
                                <i class="fas fa-lock mb-2 fa-2x"></i>
                                <h5>Comanda Fechada</h5>
                                <p class="mb-0">Este pedido já foi encerrado e contabilizado no caixa.</p>
                                @if (pagamentosRegistrados.Any())
                                {
                                    <hr class="my-2" />
                                    <small class="text-muted">Pago em @pagamentosRegistrados.Count parcela(s) — Total: R$ @totalPago.ToString("F2")</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string ComandaId { get; set; } = string.Empty;

    private MComanda? comanda;
    private List<MItemComanda> itens = new();
    private Dictionary<string, List<MAdicionaisItemComanda>> adicionaisPorItem = new();
    private List<MPagamentoComanda> pagamentosRegistrados = new();

    private double subtotal = 0;
    private double totalPago = 0;
    private double saldoPendente = 0;

    private string formaPagamentoNovo = "PIX";
    private double valorNovoPagamento = 0;

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";

    private string CurrentUserId = "1"; // Mocked user

    protected override void OnInitialized()
    {
        CarregarComanda();
    }

    private void CarregarComanda()
    {
        if (int.TryParse(ComandaId, out int id))
        {
            comanda = ComandaService.GetById(id);
            if (comanda != null)
            {
                itens = ItemComandaService.Find(new Dictionary<string, object> { { "ComandaId", comanda.Id.ToString() } });

                // Carregar adicionais de cada item
                adicionaisPorItem = new();
                foreach (var item in itens)
                {
                    var ads = AdicionaisItemComandaService.Find(new Dictionary<string, object> { { "ItemComandaId", item.Id.ToString() } });
                    if (ads != null && ads.Any())
                        adicionaisPorItem[item.Id.ToString()] = ads;
                }

                // Carregar pagamentos já registrados
                pagamentosRegistrados = PagamentoComandaService.Find(new Dictionary<string, object> { { "ComandaId", comanda.Id.ToString() } }) ?? new();

                Recalcular();
            }
            else
            {
                ExibirAlerta("Comanda não encontrada.", "alert-danger");
            }
        }
    }

    private void Recalcular()
    {
        if (comanda == null) return;

        // Subtotal: itens não cancelados + seus adicionais
        subtotal = itens
            .Where(x => x.Status != "Cancelado")
            .Sum(x =>
            {
                var ads = adicionaisPorItem.GetValueOrDefault(x.Id.ToString(), new());
                return x.TotalItem + ads.Sum(a => a.TotalAdicional);
            });

        comanda.Total = subtotal + comanda.TaxaServico - comanda.Desconto;
        if (comanda.Total < 0) comanda.Total = 0;

        // Atualizar saldo considerando pagamentos já lançados
        var verificacao = CaixaLogic.VerificarComandaQuitada(comanda.Id.ToString(), comanda.Total);
        totalPago = verificacao.TotalPago;
        saldoPendente = verificacao.SaldoPendente;
    }

    private void AdicionarPagamento()
    {
        LimparAlerta();

        if (valorNovoPagamento <= 0)
        {
            ExibirAlerta("Informe um valor maior que zero.", "alert-warning");
            return;
        }
        if (comanda == null) return;

        var result = CaixaLogic.RegistrarPagamentoParcial(
            comanda.Id.ToString(),
            formaPagamentoNovo,
            valorNovoPagamento,
            CurrentUserId
        );

        if (result.Sucesso)
        {
            ExibirAlerta(result.Mensagem, "alert-success");
            valorNovoPagamento = 0;
            pagamentosRegistrados = PagamentoComandaService.Find($"ComandaId = '{comanda.Id}'") ?? new();
            Recalcular();
        }
        else
        {
            ExibirAlerta(result.Mensagem, "alert-danger");
        }
    }

    /// <summary>
    /// Muda o status da comanda para AguardandoPagamento e atualiza a mesa.
    /// Indica à cozinha/garçom que a mesa pediu a conta.
    /// </summary>
    private void SolicitarFechamento()
    {
        LimparAlerta();
        if (comanda == null || comanda.Status != "Aberta") return;

        comanda.Status = "AguardandoPagamento";
        ComandaService.Save(comanda);

        // Atualizar status da mesa
        AtualizarStatusMesa(StatusMesa.AguardandoPagamento);

        ExibirAlerta("Mesa marcada como 'Aguardando Pagamento'. Registre os pagamentos abaixo.", "alert-info");
    }

    /// <summary>
    /// Confirma a quitação da comanda — só executa quando saldo == 0.
    /// Fecha a comanda e libera a mesa.
    /// </summary>
    private void ConfirmarQuitacao()
    {
        LimparAlerta();

        if (comanda == null) return;
        if (saldoPendente > 0.01)
        {
            ExibirAlerta($"Saldo pendente de R$ {saldoPendente:F2}. Registre o pagamento restante.", "alert-danger");
            return;
        }

        comanda.Status = "Fechada";
        comanda.DataFechamento = DateTime.UtcNow;
        bool salvo = ComandaService.Save(comanda);

        if (salvo)
        {
            // Liberar a mesa
            AtualizarStatusMesa(StatusMesa.Livre);
            ExibirAlerta("Comanda quitada e fechada com sucesso! Mesa liberada.", "alert-success");
        }
        else
        {
            comanda.Status = "AguardandoPagamento"; // Rollback visual
            ExibirAlerta("Erro ao registrar o fechamento.", "alert-danger");
        }
    }

    private void AtualizarStatusMesa(string novoStatus)
    {
        if (comanda == null || string.IsNullOrEmpty(comanda.MesaId)) return;
        var mesas = MesaService.Find(new Dictionary<string, object> { { "Identificacao", comanda.MesaId } });
        var mesa = mesas?.FirstOrDefault();
        if (mesa != null)
        {
            mesa.Status = novoStatus;
            MesaService.Save(mesa);
        }
    }

    private string ObterClasseStatusComanda(string status) => status switch
    {
        "Aberta" => "bg-success",
        "AguardandoPagamento" => "bg-warning text-dark",
        "Fechada" => "bg-secondary",
        "Cancelada" => "bg-danger",
        _ => "bg-secondary"
    };

    private void ExibirAlerta(string mensagem, string classe)
    {
        mensagemAlerta = mensagem;
        classeAlerta = classe;
    }

    private void LimparAlerta()
    {
        mensagemAlerta = "";
    }
}
