@page "/compras"
@using JT_Classes.Restaurante
@using JT_Servicos.Restaurante
@using JT_Food.Shared.Components
@inject CompraRestauranteService CompraService

<PageTitle>Entrada de Estoque (Compras) - JT Food</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Compras e Entradas</h1>
        <button class="btn btn-primary shadow-sm" @onclick="NovaCompra">
            <i class="fas fa-cart-plus fa-sm text-white-50 me-2"></i> Registrar Compra
        </button>
    </div>

    <GridCompras Compras="compras" IsLoading="loading" />
</div>

<ModalCompra @ref="modalCompra" OnSaved="CarregarComprasAsync" />

@code {
    private List<MCompra>? compras;
    private bool loading = true;
    private ModalCompra modalCompra = default!;

    protected override async Task OnInitializedAsync()
    {
        await CarregarComprasAsync();
    }

    private async Task CarregarComprasAsync()
    {
        loading = true;
        compras = await CompraService.GetAll();
        loading = false;
        StateHasChanged();
    }

    private void NovaCompra()
    {
        modalCompra.Open();
    }
}

