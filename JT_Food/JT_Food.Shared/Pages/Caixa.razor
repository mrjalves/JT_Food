@page "/caixa"
@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Restaurante
@inject CaixaLogic CaixaLogic
@inject MovimentacaoCaixaService MovimentacaoCaixaService
@inject IComandaService ComandaService
@inject NavigationManager Navigation

<PageTitle>Controle de Caixa - JT Food</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- 1. Cabeçalho Executivo -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="h3 fw-bold text-dark mb-0">
                    <i class="bi bi-cash-stack text-success me-2"></i>Controle de Caixa & PDV
                </h2>
                @if (CaixaAberto && caixaAtual != null)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fs-6">
                        <i class="bi bi-circle-fill me-1 small text-success"></i> Turno Ativo #@caixaAtual.Id
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 fs-6">
                        <i class="bi bi-lock-fill me-1 small"></i> Caixa Fechado
                    </span>
                }
            </div>
            <p class="text-muted small mb-0">Gestão de turno, sangrias, reforços, vendas e recebimentos de comandas.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="CarregarDadosAsync" title="Atualizar dados">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@mensagemAlerta
            <button type="button" class="btn-close" @onclick="LimparAlerta"></button>
        </div>
    }

    @if (!CaixaAberto)
    {
        <!-- ESTADO: CAIXA FECHADO -->
        <div class="row g-4">
            <!-- Formulário de Abertura de Caixa -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-unlock-fill me-2"></i>Abertura de Novo Turno
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small mb-3">
                            Informe o saldo inicial em dinheiro (fundo de troco) disponível na gaveta para iniciar a operação.
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Operador Responsável:</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-person-fill"></i></span>
                                <input type="text" class="form-control" value="Operador Geral (PDV 01)" disabled />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Fundo de Troco Inicial (R$):</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light fw-bold text-muted">R$</span>
                                <input type="number" class="form-control fw-bold text-end fs-4" @bind="saldoInicial" step="10.00" min="0" placeholder="0,00" />
                            </div>
                            <!-- Atalhos Rápidos de Valor Inicial -->
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => saldoInicial = 50">+ R$ 50</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => saldoInicial = 100">+ R$ 100</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => saldoInicial = 200">+ R$ 200</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => saldoInicial = 0">Zerar</button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">Observação de Abertura:</label>
                            <input type="text" class="form-control" @bind="observacaoAbertura" placeholder="Ex: Abertura turno matutino" />
                        </div>

                        <button class="btn btn-success btn-lg w-100 fw-bold shadow-sm" @onclick="AbrirCaixaAsync" disabled="@processando">
                            @if (processando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Abrindo Caixa...</span>
                            }
                            else
                            {
                                <i class="bi bi-key-fill me-2"></i>
                                <span>Abrir Caixa e Iniciar Operação</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            <!-- Histórico dos Caixas Anteriores -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-clock-history text-primary me-2"></i>Histórico de Turnos Fechados
                        </h5>
                        <span class="badge bg-light text-muted border">Últimos Turnos</span>
                    </div>
                    <div class="card-body p-0">
                        @if (!historicoCaixas.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-archive fs-1 opacity-25"></i>
                                <p class="mt-2 mb-0">Nenhum turno anterior registrado ainda.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Turno</th>
                                            <th>Abertura</th>
                                            <th>Fechamento</th>
                                            <th class="text-end">Fundo Inicial</th>
                                            <th class="text-end">Calculado</th>
                                            <th class="text-end">Informado</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in historicoCaixas)
                                        {
                                            double dif = c.SaldoFinalInformado - c.SaldoFinalCalculado;
                                            <tr>
                                                <td class="fw-bold text-primary">#@c.Id</td>
                                                <td>@c.DataAbertura.ToString("dd/MM HH:mm")</td>
                                                <td>@(c.DataFechamento?.ToString("dd/MM HH:mm") ?? "-")</td>
                                                <td class="text-end text-muted">R$ @c.SaldoInicial.ToString("F2")</td>
                                                <td class="text-end fw-semibold">R$ @c.SaldoFinalCalculado.ToString("F2")</td>
                                                <td class="text-end fw-bold text-dark">R$ @c.SaldoFinalInformado.ToString("F2")</td>
                                                <td>
                                                    <span class="badge @(c.Status == "Aberto" ? "bg-success" : "bg-secondary")">
                                                        @c.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ESTADO: CAIXA ABERTO -->
        <!-- 2. KPIs de Saldo e Totais do Turno -->
        <div class="row g-3 mb-4">
            <!-- Saldo Atual na Gaveta -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 me-3 fs-3">
                            <i class="bi bi-safe2-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Saldo em Gaveta (Calculado)</span>
                            <span class="fs-4 fw-bold text-success">R$ @(caixaAtual?.SaldoFinalCalculado.ToString("F2") ?? "0,00")</span>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Fundo inicial: R$ @(caixaAtual?.SaldoInicial.ToString("F2") ?? "0,00")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total de Vendas no Turno -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 me-3 fs-3">
                            <i class="bi bi-cart-check-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Vendas no Turno</span>
                            <span class="fs-4 fw-bold text-primary">R$ @TotalVendas.ToString("F2")</span>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">@TotalVendasQtd venda(s) registrada(s)</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reforços / Suprimentos -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 me-3 fs-3">
                            <i class="bi bi-arrow-down-left-circle-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Reforços / Entradas (+)</span>
                            <span class="fs-4 fw-bold text-dark">R$ @TotalReforcos.ToString("F2")</span>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Suprimentos de troco</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sangrias / Retiradas -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 me-3 fs-3">
                            <i class="bi bi-arrow-up-right-circle-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Sangrias / Saídas (-)</span>
                            <span class="fs-4 fw-bold text-danger">R$ @TotalSangrias.ToString("F2")</span>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Retiradas de segurança</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Totais por Meio de Pagamento -->
        <div class="card border-0 shadow-sm mb-4 bg-white">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="small fw-bold text-muted text-uppercase">
                        <i class="bi bi-wallet2 me-1 text-primary"></i> Vendas por Forma de Pagamento:
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="badge bg-light text-dark border p-2">
                            <span class="text-muted me-1">💵 Dinheiro:</span>
                            <strong class="text-success">R$ @TotalDinheiro.ToString("F2")</strong>
                        </div>
                        <div class="badge bg-light text-dark border p-2">
                            <span class="text-muted me-1">📱 PIX:</span>
                            <strong class="text-primary">R$ @TotalPix.ToString("F2")</strong>
                        </div>
                        <div class="badge bg-light text-dark border p-2">
                            <span class="text-muted me-1">💳 Débito:</span>
                            <strong class="text-info">R$ @TotalDebito.ToString("F2")</strong>
                        </div>
                        <div class="badge bg-light text-dark border p-2">
                            <span class="text-muted me-1">💳 Crédito:</span>
                            <strong class="text-dark">R$ @TotalCredito.ToString("F2")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Grid Operacional: Coluna Esquerda (Ações de Gaveta) / Coluna Direita (Comandas e Extrato) -->
        <div class="row g-4">
            <!-- Coluna Esquerda: Sangria, Reforço e Encerramento -->
            <div class="col-12 col-lg-4">
                <!-- Card: Sangria / Reforço -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-arrow-left-right text-primary me-2"></i>Sangria / Reforço de Gaveta
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Tipo de Movimentação:</label>
                            <select class="form-select" @bind="tipoMovimentacaoSelecionada">
                                <option value="Sangria">Sangria (Retirada de Dinheiro)</option>
                                <option value="Reforço">Reforço (Entrada de Troco)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Valor (R$):</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">R$</span>
                                <input type="number" class="form-control text-end fw-bold" @bind="valorMovimentacao" step="0.50" min="0" placeholder="0,00" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Motivo / Justificativa:</label>
                            <input type="text" class="form-control" @bind="observacaoMovimentacao" placeholder="Ex: Troco inicial, Sangria cofre" />
                        </div>

                        <button class="btn btn-warning w-100 fw-bold text-dark" @onclick="RegistrarSangriaReforcoAsync" disabled="@processando">
                            <i class="bi bi-check2-circle me-1"></i> Gravar Movimentação
                        </button>
                    </div>
                </div>

                <!-- Card: Encerramento de Turno -->
                <div class="card border-0 shadow-sm border-danger border-opacity-25">
                    <div class="card-header bg-danger bg-opacity-10 text-danger py-3">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-door-closed-fill me-2"></i>Encerramento de Turno
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">
                            Conte as cédulas e moedas físicas presentes na gaveta para confrontar com o saldo do sistema.
                        </p>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted">Valor Real em Gaveta (R$):</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">R$</span>
                                <input type="number" class="form-control text-end fw-bold fs-5 text-dark" @bind="saldoInformadoFinal" step="1.00" min="0" />
                            </div>
                        </div>

                        <!-- Indicador de Diferença -->
                        @{
                            double esperado = caixaAtual?.SaldoFinalCalculado ?? 0;
                            double dif = saldoInformadoFinal - esperado;
                        }
                        <div class="mb-3 text-center">
                            @if (Math.Abs(dif) < 0.01)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 p-2 w-100">
                                    <i class="bi bi-check-circle-fill me-1"></i> Conferência Exata (Sem divergência)
                                </span>
                            }
                            else if (dif > 0)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 p-2 w-100">
                                    <i class="bi bi-plus-circle-fill me-1"></i> Sobra em gaveta: R$ @dif.ToString("F2")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 p-2 w-100">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Falta em gaveta: R$ @Math.Abs(dif).ToString("F2")
                                </span>
                            }
                        </div>

                        <button class="btn btn-outline-danger w-100 fw-bold" @onclick="FecharCaixaAsync" disabled="@processando">
                            <i class="bi bi-lock-fill me-1"></i> Efetuar Fechamento de Caixa
                        </button>
                    </div>
                </div>
            </div>

            <!-- Coluna Direita: Fila de Cobrança e Extrato -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <ul class="nav nav-pills card-header-pills">
                            <li class="nav-item">
                                <button class="nav-link @(abaDireita == "comandas" ? "active fw-bold" : "")" @onclick='() => abaDireita = "comandas"'>
                                    <i class="bi bi-receipt me-1"></i> Comandas para Cobrança (@comandasAbertas.Count)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(abaDireita == "extrato" ? "active fw-bold" : "")" @onclick='() => abaDireita = "extrato"'>
                                    <i class="bi bi-journal-text me-1"></i> Extrato do Turno (@movimentacoes.Count)
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-0">
                        @if (abaDireita == "comandas")
                        {
                            <!-- Lista de Comandas em Aberto para Pagamento -->
                            @if (!comandasAbertas.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-check2-all fs-1 text-success opacity-50"></i>
                                    <p class="mt-2 mb-0">Nenhuma comanda aberta aguardando recebimento no momento.</p>
                                    <small class="text-muted">Novos pedidos lançados nas mesas aparecerão aqui para quitação.</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Identificação / Cliente</th>
                                                <th>Mesa</th>
                                                <th>Abertura</th>
                                                <th class="text-end">Total Acumulado</th>
                                                <th>Status</th>
                                                <th class="text-end">Ação</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in comandasAbertas)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-primary">#@c.Id</td>
                                                    <td class="fw-semibold text-dark">
                                                        @(string.IsNullOrWhiteSpace(c.NomeCliente) ? "Consumidor" : c.NomeCliente)
                                                    </td>
                                                    <td>
                                                        @if (string.IsNullOrEmpty(c.MesaId))
                                                        {
                                                            <span class="badge bg-light text-muted border">Balcão</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                @(c.MesaId.StartsWith("Mesa", StringComparison.OrdinalIgnoreCase) ? c.MesaId : $"Mesa {c.MesaId}")
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>@c.DataAbertura.ToString("HH:mm")</td>
                                                    <td class="text-end fw-bold text-success fs-6">R$ @c.Total.ToString("F2")</td>
                                                    <td>
                                                        <span class="badge @(c.Status == "Aberta" ? "bg-primary" : "bg-warning text-dark")">
                                                            @c.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-success fw-bold px-3" @onclick="() => IrParaFechamento(c.Id)">
                                                            <i class="bi bi-cash-coin me-1"></i> Cobrar / Fechar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Extrato de Movimentações -->
                            @if (!movimentacoes.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt-cutoff fs-1 opacity-25"></i>
                                    <p class="mt-2 mb-0">Nenhuma movimentação financeira gravada neste turno.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Hora</th>
                                                <th>Operação</th>
                                                <th>Forma Pagto</th>
                                                <th>Descrição</th>
                                                <th>Natureza</th>
                                                <th class="text-end">Valor (R$)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mov in movimentacoes.OrderByDescending(x => x.DataHora))
                                            {
                                                <tr>
                                                    <td>@mov.DataHora.ToString("HH:mm:ss")</td>
                                                    <td class="fw-bold">@mov.TipoMovimentacao</td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border">@mov.FormaPagamento</span>
                                                    </td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(mov.Descricao) ? "-" : mov.Descricao)</td>
                                                    <td>
                                                        @if (mov.Natureza == "Entrada")
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Entrada</span>
                                                        }
                                                        else if (mov.Natureza == "Saida")
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Saída</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Info</span>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold @(mov.Natureza == "Saida" ? "text-danger" : "text-success")">
                                                        @(mov.Natureza == "Saida" ? "- " : "+ ")R$ @mov.Valor.ToString("F2")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool CaixaAberto = false;
    private MCaixa? caixaAtual;
    private List<MMovimentacaoCaixa> movimentacoes = new();
    private List<MCaixa> historicoCaixas = new();
    private List<JT_Classes.Restaurante.Comanda> comandasAbertas = new();

    private double saldoInicial = 100.0;
    private double saldoInformadoFinal = 0.0;
    private string observacaoAbertura = "Abertura de turno normal";

    private string tipoMovimentacaoSelecionada = "Sangria";
    private double valorMovimentacao = 0.0;
    private string observacaoMovimentacao = "";

    private string abaDireita = "comandas";
    private bool processando = false;

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";
    private string CurrentUserId = "1";

    // Totais calculados
    private double TotalVendas => movimentacoes.Where(x => x.TipoMovimentacao == "Venda").Sum(x => x.Valor);
    private int TotalVendasQtd => movimentacoes.Count(x => x.TipoMovimentacao == "Venda");
