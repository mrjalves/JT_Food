@code {
    private bool CaixaAberto = false;
    private MCaixa? caixaAtual;
    private List<MMovimentacaoCaixa> movimentacoes = new();
    private List<MCaixa> historicoCaixas = new();
    private List<JT_Classes.Restaurante.Comanda> comandasAbertas = new();

    private double saldoInicial = 100.0;
    private double saldoInformadoFinal = 0.0;
    private string observacaoAbertura = "Abertura de turno normal";

    private string tipoMovimentacaoSelecionada = "Sangria";
    private double valorMovimentacao = 0.0;
    private string observacaoMovimentacao = "";

    private string abaDireita = "comandas";
    private bool processando = false;

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";
    private string CurrentUserId = "1";
    private Usuario operadorSelecionado = UsuarioMockProvider.ObterPadrao();
    private Dictionary<string, string> colunasUsuario = new()
    {
        { "Código", "Id" },
        { "Nome do Operador", "Nome" },
        { "Login", "Login" },
        { "Perfil", "Role" }
    };

    // Totais calculados
    private double TotalVendas => movimentacoes.Where(x => x.TipoMovimentacao == "Venda").Sum(x => x.Valor);
    private int TotalVendasQtd => movimentacoes.Count(x => x.TipoMovimentacao == "Venda");
    private double TotalReforcos => movimentacoes.Where(x => x.TipoMovimentacao == "Reforço").Sum(x => x.Valor);
    private double TotalSangrias => movimentacoes.Where(x => x.TipoMovimentacao == "Sangria").Sum(x => x.Valor);

    private double TotalDinheiro => movimentacoes.Where(x => x.TipoMovimentacao == "Venda" && x.FormaPagamento.Contains("Dinheiro", StringComparison.OrdinalIgnoreCase)).Sum(x => x.Valor);
    private double TotalPix => movimentacoes.Where(x => x.TipoMovimentacao == "Venda" && x.FormaPagamento.Contains("PIX", StringComparison.OrdinalIgnoreCase)).Sum(x => x.Valor);
    private double TotalDebito => movimentacoes.Where(x => x.TipoMovimentacao == "Venda" && x.FormaPagamento.Contains("Debito", StringComparison.OrdinalIgnoreCase)).Sum(x => x.Valor);
    private double TotalCredito => movimentacoes.Where(x => x.TipoMovimentacao == "Venda" && x.FormaPagamento.Contains("Credito", StringComparison.OrdinalIgnoreCase)).Sum(x => x.Valor);

    protected override async Task OnInitializedAsync()
    {
        if (operadorSelecionado == null)
        {
            operadorSelecionado = UsuarioMockProvider.ObterPadrao();
            CurrentUserId = operadorSelecionado.Id.ToString();
        }
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        processando = true;
        try
        {
            var result = await CaixaLogic.ObterCaixaAbertoAsync();
            CaixaAberto = result.Sucesso;
            caixaAtual = result.CaixaAtual;

            if (CaixaAberto && caixaAtual != null)
            {
                var allMov = await MovimentacaoCaixaService.GetAll();
                movimentacoes = (allMov ?? Enumerable.Empty<MMovimentacaoCaixa>())
                    .Where(m => m.CaixaId == caixaAtual.Id.ToString())
                    .ToList();

                saldoInformadoFinal = caixaAtual.SaldoFinalCalculado;

                // Carrega comandas em aberto para a fila do caixa
                var todasComandas = await ComandaService.GetAllAsync();
                comandasAbertas = (todasComandas ?? Enumerable.Empty<JT_Classes.Restaurante.Comanda>())
                    .Where(c => c.Status != "Fechada" && c.Status != "Cancelada")
                    .OrderByDescending(c => c.Total)
                    .ToList();
            }
            else
            {
                caixaAtual = null;
                movimentacoes.Clear();
                comandasAbertas.Clear();
                historicoCaixas = await CaixaLogic.ObterHistoricoCaixasAsync(10);
            }
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Erro ao carregar dados do caixa: {ex.Message}", "alert-danger");
        }
        processando = false;
        StateHasChanged();
    }

    private async Task AbrirCaixaAsync()
    {
        LimparAlerta();
        processando = true;
        try
        {
            string opId = operadorSelecionado?.Id.ToString() ?? CurrentUserId;
            string opNome = operadorSelecionado?.Nome ?? "Operador Geral";
            string obsComposta = string.IsNullOrWhiteSpace(observacaoAbertura)
                ? $"Operador: {opNome}"
                : $"{observacaoAbertura} (Operador: {opNome})";

            var result = await CaixaLogic.AbrirCaixaAsync(opId, saldoInicial, obsComposta);
            if (result.Sucesso)
            {
                ExibirAlerta(result.Mensagem, "alert-success");
                await CarregarDadosAsync();
            }
            else
            {
                ExibirAlerta(result.Mensagem, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Erro ao abrir o caixa: {ex.Message}", "alert-danger");
        }
        processando = false;
    }

    private async Task<IEnumerable<Usuario>> CarregarUsuariosAsync()
    {
        try
        {
            var usuarioService = ServiceProvider.GetService(typeof(IUsuarioService)) as IUsuarioService;
            if (usuarioService != null)
            {
                var usuariosReais = await usuarioService.ObterTodosUsuariosAsync();
                if (usuariosReais != null && usuariosReais.Any())
                {
                    var lista = usuariosReais.Where(u => u.Ativo).ToList();
                    if (lista.Any())
                    {
                        return lista;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Caixa] Aviso ao buscar usuários reais: {ex.Message}. Utilizando mocks.");
        }

        // Fallback e mocks prontos para testes futuros
        return UsuarioMockProvider.ObterUsuariosMock();
    }

    private void OnOperadorSelecionado(Usuario usuario)
    {
        if (usuario != null)
        {
            operadorSelecionado = usuario;
            CurrentUserId = usuario.Id.ToString();
            StateHasChanged();
        }
    }

    private string ObterNomeOperador(string? operadorId)
    {
        if (string.IsNullOrWhiteSpace(operadorId)) return "Operador Geral";
        if (int.TryParse(operadorId, out int idNum))
        {
            var mock = UsuarioMockProvider.ObterPorId(idNum);
            if (mock != null) return mock.Nome;
        }
        return $"Operador #{operadorId}";
    }

    private async Task RegistrarSangriaReforcoAsync()
    {
        LimparAlerta();
        if (valorMovimentacao <= 0)
        {
            ExibirAlerta("O valor da movimentação deve ser maior que zero.", "alert-warning");
            return;
        }

        if (caixaAtual == null) return;

        processando = true;
        try
        {
            string natureza = tipoMovimentacaoSelecionada == "Sangria" ? "Saida" : "Entrada";
            await CaixaLogic.RegistrarMovimentacaoAsync(
                caixaAtual.Id.ToString(),
                CurrentUserId,
                tipoMovimentacaoSelecionada,
                natureza,
                valorMovimentacao,
                "Dinheiro",
                string.IsNullOrWhiteSpace(observacaoMovimentacao) ? $"{tipoMovimentacaoSelecionada} manual" : observacaoMovimentacao
            );

            ExibirAlerta($"{tipoMovimentacaoSelecionada} de R$ {valorMovimentacao:F2} registrada com sucesso!", "alert-success");
            valorMovimentacao = 0;
            observacaoMovimentacao = "";
            await CarregarDadosAsync();
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Erro ao registrar movimentação: {ex.Message}", "alert-danger");
        }
        processando = false;
    }

    private async Task FecharCaixaAsync()
    {
        LimparAlerta();
        if (caixaAtual == null) return;

        processando = true;
        try
        {
            var result = await CaixaLogic.FecharCaixaAsync(caixaAtual.Id.ToString(), CurrentUserId, saldoInformadoFinal, "Fechamento de turno manual");
            if (result.Sucesso)
            {
                ExibirAlerta(result.Mensagem, "alert-success");
                await CarregarDadosAsync();
            }
            else
            {
                ExibirAlerta(result.Mensagem, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            ExibirAlerta($"Erro ao fechar caixa: {ex.Message}", "alert-danger");
        }
        processando = false;
    }

    private void IrParaFechamento(int comandaId)
    {
        Navigation.NavigateTo($"/fechamento/{comandaId}");
    }

    private void ExibirAlerta(string mensagem, string classe)
    {
        mensagemAlerta = mensagem;
        classeAlerta = classe;
    }

    private void LimparAlerta() => mensagemAlerta = "";
}
