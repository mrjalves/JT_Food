@page "/caixa"
@using JT_Classes.Acessos
@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Mocks
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Restaurante
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Services.Interfaces.Acessos
@inject CaixaLogic CaixaLogic
@inject MovimentacaoCaixaService MovimentacaoCaixaService
@inject IComandaService ComandaService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<PageTitle>Controle de Caixa - JT Food</PageTitle>

<div class="container-fluid py-4 px-4 caixa-page-container">
    <!-- 1. Cabeçalho Executivo Ultra Moderno -->
    <div class="cx-header-card p-4 mb-4 rounded-4 shadow-sm bg-white border" data-tutorial="caixa-header">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="cx-brand-badge shadow-sm">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h4 fw-bold text-dark mb-0 cx-page-title">
                            Controle de Caixa &amp; PDV
                        </h2>
                        @if (CaixaAberto && caixaAtual != null)
                        {
                            <span class="cx-status-pill cx-pill-open">
                                <span class="cx-pulse-dot"></span> Turno Ativo #@caixaAtual.Id
                            </span>
                            <span class="cx-status-pill cx-pill-operator">
                                <i class="bi bi-person-fill"></i> @ObterNomeOperador(caixaAtual.OperadorAberturaId)
                            </span>
                        }
                        else
                        {
                            <span class="cx-status-pill cx-pill-closed">
                                <i class="bi bi-lock-fill"></i> Caixa Fechado
                            </span>
                        }
                    </div>
                    <p class="text-muted small mb-0">
                        Gestão de turno, suprimentos, sangrias de gaveta, vendas em tempo real e quitação de comandas.
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm cx-btn-refresh shadow-sm" @onclick="CarregarDadosAsync" disabled="@processando" title="Atualizar dados do caixa">
                    @if (processando)
                    {
                        <span class="spinner-border spinner-border-sm me-1.5" role="status"></span>
                        <span>Atualizando...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise me-1.5"></i>
                        <span>Atualizar</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="cx-alert @classeAlerta shadow-sm mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2.5">
                @if (classeAlerta.Contains("danger"))
                {
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                }
                else if (classeAlerta.Contains("warning"))
                {
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                }
                else
                {
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                }
                <span class="small fw-medium">@mensagemAlerta</span>
            </div>
            <button type="button" class="btn-close btn-close-sm" @onclick="LimparAlerta"></button>
        </div>
    }

    @if (!CaixaAberto)
    {
        <!-- ESTADO: CAIXA FECHADO -->
        <div class="row g-4">
            <!-- Formulário de Abertura de Caixa -->
            <div class="col-12 col-lg-5">
                <div class="cx-card shadow-sm border-0 h-100" data-tutorial="caixa-abertura">
                    <div class="cx-card-header cx-header-primary p-3.5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="cx-header-icon-box shadow-sm">
                                <i class="bi bi-key-fill"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold cx-white-title">
                                    Abertura de Novo Turno
                                </h5>
                                <span class="cx-white-sub">Inicie a operação com fundo de troco</span>
                            </div>
                        </div>
                    </div>
                    <div class="cx-card-body p-4 bg-white">
                        <p class="text-muted small mb-3">
                            Selecione o operador responsável e informe o saldo inicial disponível em espécie na gaveta.
                        </p>

                        <div class="mb-3.5">
                            <label class="form-label fw-bold text-dark small d-flex justify-content-between align-items-center mb-1.5">
                                <span><i class="bi bi-person-badge text-primary me-1.5"></i>Operador do Turno:</span>
                                @if (operadorSelecionado != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace small px-2 py-1">
                                        @operadorSelecionado.Role
                                    </span>
                                }
                            </label>
                            <div class="cx-seletor-box">
                                <SeletorPesquisa TItem="Usuario"
                                                 TituloPesquisa="Selecionar Operador do Caixa"
                                                 LoadDataAsync="CarregarUsuariosAsync"
                                                 ObterCodigo="@(u => u.Id.ToString())"
                                                 ObterDescricao="@(u => !string.IsNullOrWhiteSpace(u.Nome) ? u.Nome : u.Login)"
                                                 Colunas="@colunasUsuario"
                                                 ValorSelecionado="@operadorSelecionado"
                                                 ValorSelecionadoChanged="OnOperadorSelecionado" />
                            </div>
                            <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                                Usuário autenticado para prestação de contas deste turno.
                            </small>
                        </div>

                        <div class="mb-3.5">
                            <label class="form-label fw-bold text-dark small">Fundo de Troco Inicial (R$):</label>
                            <div class="input-group input-group-lg cx-input-group">
                                <span class="input-group-text bg-slate-100 fw-bold text-secondary">R$</span>
                                <input type="number" class="form-control fw-bold text-end fs-4 text-dark" @bind="saldoInicial" step="10.00" min="0" placeholder="0,00" />
                            </div>
                            <!-- Atalhos Rápidos de Valor Inicial -->
                            <div class="d-flex flex-wrap gap-1.5 mt-2">
                                <button type="button" class="btn btn-sm cx-quick-val-btn" @onclick="() => saldoInicial = 50">+ R$ 50</button>
                                <button type="button" class="btn btn-sm cx-quick-val-btn" @onclick="() => saldoInicial = 100">+ R$ 100</button>
                                <button type="button" class="btn btn-sm cx-quick-val-btn" @onclick="() => saldoInicial = 200">+ R$ 200</button>
                                <button type="button" class="btn btn-sm cx-quick-val-btn" @onclick="() => saldoInicial = 500">+ R$ 500</button>
                                <button type="button" class="btn btn-sm cx-quick-val-btn text-muted" @onclick="() => saldoInicial = 0">Zerar</button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">Observação de Abertura:</label>
                            <input type="text" class="form-control cx-input-control" @bind="observacaoAbertura" placeholder="Ex: Turno almoço / Abertura padrão" />
                        </div>

                        <button class="btn btn-lg w-100 fw-bold cx-btn-open-turn shadow-sm" @onclick="AbrirCaixaAsync" disabled="@processando">
                            @if (processando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Abrindo Caixa...</span>
                            }
                            else
                            {
                                <i class="bi bi-unlock-fill me-2"></i>
                                <span>Abrir Caixa e Iniciar Operação</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            <!-- Histórico dos Caixas Anteriores -->
            <div class="col-12 col-lg-7">
                <div class="cx-card shadow-sm border-0 h-100">
                    <div class="cx-card-header cx-header-clean p-3.5 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="cx-header-icon-box cx-icon-slate shadow-sm">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Histórico de Turnos Fechados</h5>
                                <span class="text-muted small">Auditoria de turnos anteriores e divergências</span>
                            </div>
                        </div>
                        <span class="badge rounded-pill cx-badge-slate">Últimos Turnos</span>
                    </div>
                    <div class="cx-card-body p-0 bg-white">
                        @if (!historicoCaixas.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-archive fs-1 opacity-25 d-block mb-2"></i>
                                <h6 class="fw-semibold text-dark">Nenhum turno anterior registrado</h6>
                                <p class="small text-muted mb-0">Os registros de fechamentos e auditoria aparecerão aqui.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 cx-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Turno</th>
                                            <th>Abertura</th>
                                            <th>Fechamento</th>
                                            <th class="text-end">Fundo Inicial</th>
                                            <th class="text-end">Calculado</th>
                                            <th class="text-end">Informado</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in historicoCaixas)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#@c.Id</td>
                                                <td class="small">@c.DataAbertura.ToString("dd/MM HH:mm")</td>
                                                <td class="small text-muted">@(c.DataFechamento?.ToString("dd/MM HH:mm") ?? "-")</td>
                                                <td class="text-end text-muted small">R$ @c.SaldoInicial.ToString("F2")</td>
                                                <td class="text-end fw-semibold">R$ @c.SaldoFinalCalculado.ToString("F2")</td>
                                                <td class="text-end fw-bold text-dark">R$ @c.SaldoFinalInformado.ToString("F2")</td>
                                                <td class="text-center">
                                                    @if (c.Status == "Aberto")
                                                    {
                                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1">Aberto</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Fechado</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ESTADO: CAIXA ABERTO -->
        <!-- 2. KPIs Executivos do Turno -->
        <div class="row g-3 mb-4" data-tutorial="caixa-balanco">
            <!-- Saldo Atual na Gaveta -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="cx-kpi-card cx-kpi-emerald shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="cx-kpi-icon shadow-sm me-3">
                            <i class="bi bi-safe2-fill"></i>
                        </div>
                        <div>
                            <span class="cx-kpi-label">Saldo em Gaveta (Calculado)</span>
                            <span class="cx-kpi-val text-success">R$ @(caixaAtual?.SaldoFinalCalculado.ToString("F2") ?? "0,00")</span>
                            <small class="cx-kpi-sub">Fundo inicial: R$ @(caixaAtual?.SaldoInicial.ToString("F2") ?? "0,00")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total de Vendas no Turno -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="cx-kpi-card cx-kpi-indigo shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="cx-kpi-icon shadow-sm me-3">
                            <i class="bi bi-cart-check-fill"></i>
                        </div>
                        <div>
                            <span class="cx-kpi-label">Vendas no Turno</span>
                            <span class="cx-kpi-val text-primary">R$ @TotalVendas.ToString("F2")</span>
                            <small class="cx-kpi-sub">@TotalVendasQtd venda(s) registrada(s)</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reforços / Suprimentos -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="cx-kpi-card cx-kpi-sky shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="cx-kpi-icon shadow-sm me-3">
                            <i class="bi bi-arrow-down-left-circle-fill"></i>
                        </div>
                        <div>
                            <span class="cx-kpi-label">Reforços / Entradas (+)</span>
                            <span class="cx-kpi-val text-dark">R$ @TotalReforcos.ToString("F2")</span>
                            <small class="cx-kpi-sub">Suprimentos de troco</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sangrias / Retiradas -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="cx-kpi-card cx-kpi-rose shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="cx-kpi-icon shadow-sm me-3">
                            <i class="bi bi-arrow-up-right-circle-fill"></i>
                        </div>
                        <div>
                            <span class="cx-kpi-label">Sangrias / Saídas (-)</span>
                            <span class="cx-kpi-val text-danger">R$ @TotalSangrias.ToString("F2")</span>
                            <small class="cx-kpi-sub">Retiradas para cofre</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Totais por Meio de Pagamento -->
        <div class="cx-card shadow-sm border-0 mb-4 bg-white p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="small fw-bold text-dark text-uppercase d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2 text-primary fs-6"></i>
                    <span>Vendas por Forma de Pagamento:</span>
                </div>
                <div class="d-flex flex-wrap gap-2.5">
                    <div class="cx-pay-badge cx-pay-money">
                        <span class="cx-pay-label">💵 Dinheiro:</span>
                        <strong class="text-success">R$ @TotalDinheiro.ToString("F2")</strong>
                    </div>
                    <div class="cx-pay-badge cx-pay-pix">
                        <span class="cx-pay-label">📱 PIX:</span>
                        <strong class="text-primary">R$ @TotalPix.ToString("F2")</strong>
                    </div>
                    <div class="cx-pay-badge cx-pay-debit">
                        <span class="cx-pay-label">💳 Débito:</span>
                        <strong class="text-info">R$ @TotalDebito.ToString("F2")</strong>
                    </div>
                    <div class="cx-pay-badge cx-pay-credit">
                        <span class="cx-pay-label">💳 Crédito:</span>
                        <strong class="text-dark">R$ @TotalCredito.ToString("F2")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Grid Operacional -->
        <div class="row g-4">
            <!-- Coluna Esquerda: Sangria, Reforço e Encerramento -->
            <div class="col-12 col-lg-4">
                <!-- Card: Sangria / Reforço -->
                <div class="cx-card shadow-sm border-0 mb-4" data-tutorial="caixa-sangria-reforco">
                    <div class="cx-card-header cx-header-amber p-3.5">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="cx-header-icon-box cx-icon-amber shadow-sm">
                                <i class="bi bi-arrow-left-right"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold cx-white-title">
                                    Sangria / Reforço de Gaveta
                                </h6>
                                <span class="cx-white-sub">Ajustes manuais em dinheiro físico</span>
                            </div>
                        </div>
                    </div>
                    <div class="cx-card-body p-3.5 bg-white">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Tipo de Movimentação:</label>
                            <select class="form-select cx-input-control" @bind="tipoMovimentacaoSelecionada">
                                <option value="Sangria">Sangria (Retirada de Dinheiro)</option>
                                <option value="Reforço">Reforço (Entrada de Troco)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Valor (R$):</label>
                            <div class="input-group">
                                <span class="input-group-text bg-slate-100 fw-bold text-secondary">R$</span>
                                <input type="number" class="form-control text-end fw-bold fs-5 text-dark" @bind="valorMovimentacao" step="0.50" min="0" placeholder="0,00" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Motivo / Justificativa:</label>
                            <input type="text" class="form-control cx-input-control" @bind="observacaoMovimentacao" placeholder="Ex: Troco inicial, Sangria cofre" />
                        </div>

                        <button class="btn w-100 fw-bold cx-btn-amber shadow-sm" @onclick="RegistrarSangriaReforcoAsync" disabled="@processando">
                            <i class="bi bi-check2-circle me-1.5"></i> Gravar Movimentação
                        </button>
                    </div>
                </div>

                <!-- Card: Encerramento de Turno -->
                <div class="cx-card shadow-sm border-0" data-tutorial="caixa-fechamento">
                    <div class="cx-card-header cx-header-danger p-3.5">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="cx-header-icon-box cx-icon-danger shadow-sm">
                                <i class="bi bi-door-closed-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold cx-white-title">
                                    Encerramento de Turno
                                </h6>
                                <span class="cx-white-sub">Fechamento e conciliação cega de gaveta</span>
                            </div>
                        </div>
                    </div>
                    <div class="cx-card-body p-3.5 bg-white">
                        <p class="small text-muted mb-2.5">
                            Realize a contagem das cédulas e moedas físicas presentes na gaveta para conferência automática.
                        </p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Valor Real em Gaveta (R$):</label>
                            <div class="input-group">
                                <span class="input-group-text bg-slate-100 fw-bold text-secondary">R$</span>
                                <input type="number" class="form-control text-end fw-bold fs-4 text-dark" @bind="saldoInformadoFinal" step="1.00" min="0" />
                            </div>
                        </div>

                        <!-- Indicador de Diferença -->
                        @{
                            double esperado = caixaAtual?.SaldoFinalCalculado ?? 0;
                            double dif = saldoInformadoFinal - esperado;
                        }
                        <div class="mb-3">
                            @if (Math.Abs(dif) < 0.01)
                            {
                                <div class="cx-diff-box cx-diff-exact">
                                    <i class="bi bi-check-circle-fill me-1.5"></i>
                                    <span>Conferência Exata (Sem divergência)</span>
                                </div>
                            }
                            else if (dif > 0)
                            {
                                <div class="cx-diff-box cx-diff-surplus">
                                    <i class="bi bi-plus-circle-fill me-1.5"></i>
                                    <span>Sobra em gaveta: + R$ @dif.ToString("F2")</span>
                                </div>
                            }
                            else
                            {
                                <div class="cx-diff-box cx-diff-shortage">
                                    <i class="bi bi-exclamation-triangle-fill me-1.5"></i>
                                    <span>Falta em gaveta: - R$ @Math.Abs(dif).ToString("F2")</span>
                                </div>
                            }
                        </div>

                        <button class="btn btn-outline-danger w-100 fw-bold cx-btn-close-turn shadow-sm" @onclick="FecharCaixaAsync" disabled="@processando">
                            <i class="bi bi-lock-fill me-1.5"></i> Efetuar Fechamento de Caixa
                        </button>
                    </div>
                </div>
            </div>

            <!-- Coluna Direita: Fila de Cobrança e Extrato -->
            <div class="col-12 col-lg-8">
                <div class="cx-card shadow-sm border-0">
                    <div class="cx-card-header cx-header-clean p-2.5 d-flex justify-content-between align-items-center">
                        <div class="cx-tabs-group">
                            <button class="cx-tab-btn @(abaDireita == "comandas" ? "active" : "")" @onclick='() => abaDireita = "comandas"'>
                                <i class="bi bi-receipt me-1.5"></i>
                                <span>Comandas para Cobrança</span>
                                <span class="badge rounded-pill ms-1.5 @(abaDireita == "comandas" ? "bg-white text-primary" : "bg-primary-subtle text-primary")">
                                    @comandasAbertas.Count
                                </span>
                            </button>
                            <button class="cx-tab-btn @(abaDireita == "extrato" ? "active" : "")" @onclick='() => abaDireita = "extrato"'>
                                <i class="bi bi-journal-text me-1.5"></i>
                                <span>Extrato do Turno</span>
                                <span class="badge rounded-pill ms-1.5 @(abaDireita == "extrato" ? "bg-white text-primary" : "bg-secondary-subtle text-secondary")">
                                    @movimentacoes.Count
                                </span>
                            </button>
                        </div>
                    </div>

                    <div class="cx-card-body p-0 bg-white">
                        @if (abaDireita == "comandas")
                        {
                            <!-- Lista de Comandas em Aberto para Pagamento -->
                            @if (!comandasAbertas.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-check2-circle fs-1 text-success opacity-50 d-block mb-2"></i>
                                    <h6 class="fw-semibold text-dark">Nenhuma comanda aguardando recebimento</h6>
                                    <p class="small text-muted mb-0">Novos pedidos lançados nas mesas aparecerão aqui para quitação.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 cx-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Identificação / Cliente</th>
                                                <th>Mesa</th>
                                                <th>Abertura</th>
                                                <th class="text-end">Total Acumulado</th>
                                                <th>Status</th>
                                                <th class="text-end">Ação</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in comandasAbertas)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-primary">#@c.Id</td>
                                                    <td class="fw-semibold text-dark">
                                                        @(string.IsNullOrWhiteSpace(c.NomeCliente) ? "Consumidor" : c.NomeCliente)
                                                    </td>
                                                    <td>
                                                        @if (string.IsNullOrEmpty(c.MesaId))
                                                        {
                                                            <span class="badge bg-light text-muted border">Balcão</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                                @(c.MesaId.StartsWith("Mesa", StringComparison.OrdinalIgnoreCase) ? c.MesaId : $"Mesa {c.MesaId}")
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="small text-muted">@c.DataAbertura.ToString("HH:mm")</td>
                                                    <td class="text-end fw-bold text-success fs-6">R$ @c.Total.ToString("F2")</td>
                                                    <td>
                                                        <span class="badge rounded-pill @(c.Status == "Aberta" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning border border-warning-subtle")">
                                                            @c.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm cx-btn-cobrar fw-bold px-3 shadow-sm" @onclick="() => IrParaFechamento(c.Id)">
                                                            <i class="bi bi-cash-coin me-1.5"></i> Cobrar / Fechar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Extrato de Movimentações -->
                            @if (!movimentacoes.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt-cutoff fs-1 opacity-25 d-block mb-2"></i>
                                    <h6 class="fw-semibold text-dark">Nenhuma movimentação no turno</h6>
                                    <p class="small text-muted mb-0">Vendas, sangrias e reforços serão registrados aqui cronologicamente.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 540px; overflow-y: auto;">
                                    <table class="table table-hover align-middle mb-0 cx-table">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Hora</th>
                                                <th>Operação</th>
                                                <th>Forma Pagto</th>
                                                <th>Descrição</th>
                                                <th>Natureza</th>
                                                <th class="text-end">Valor (R$)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mov in movimentacoes.OrderByDescending(x => x.DataHora))
                                            {
                                                <tr>
                                                    <td class="small text-muted">@mov.DataHora.ToString("HH:mm:ss")</td>
                                                    <td class="fw-bold text-dark">@mov.TipoMovimentacao</td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border px-2 py-1">@mov.FormaPagamento</span>
                                                    </td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(mov.Descricao) ? "-" : mov.Descricao)</td>
                                                    <td>
                                                        @if (mov.Natureza == "Entrada")
                                                        {
                                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1">Entrada</span>
                                                        }
                                                        else if (mov.Natureza == "Saida")
                                                        {
                                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Saída</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-2 py-1">Info</span>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold @(mov.Natureza == "Saida" ? "text-danger" : "text-success")">
                                                        @(mov.Natureza == "Saida" ? "- " : "+ ")R$ @mov.Valor.ToString("F2")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

