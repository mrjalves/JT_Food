@page "/caixa"
@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Servicos.Restaurante
@inject CaixaLogic CaixaLogic
@inject JT_Servicos.Restaurante.MovimentacaoCaixaService MovimentacaoCaixaService

<div class="container-fluid p-3">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-0">Controle de Caixa</h2>
            <p class="text-muted">Abertura, fechamento e movimentações avulsas.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show" role="alert">
            @mensagemAlerta
            <button type="button" class="btn-close" @onclick="LimparAlerta"></button>
        </div>
    }

    <div class="row g-4">
        @if (!CaixaAberto)
        {
            <div class="col-md-6 col-lg-4 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <i class="fas fa-lock fa-3x mb-2"></i>
                        <h4 class="mb-0">Caixa Fechado</h4>
                    </div>
                    <div class="card-body">
                        <p class="text-center text-muted mb-4">Para iniciar as vendas, abra o caixa informando o saldo inicial em dinheiro.</p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Saldo Inicial (R$)</label>
                            <input type="number" class="form-control form-control-lg text-end" @bind="saldoInicial" step="0.01" min="0" />
                        </div>
                        <button class="btn btn-success btn-lg w-100" @onclick="AbrirCaixaAsync">
                            <i class="fas fa-key me-2"></i> Abrir Caixa
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <div class="card shadow-sm mb-4 border-success">
                    <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-lock-open me-2"></i> Caixa Aberto</span>
                        <span class="badge bg-light text-dark">#@caixaAtual?.Id</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold">@caixaAtual?.DataAbertura.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Saldo Inicial:</span>
                            <span class="fw-bold text-primary">R$ @caixaAtual?.SaldoInicial.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-success">R$ @movimentacoes.Where(x => x.Natureza == "Entrada").Sum(x => x.Valor).ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="fw-bold text-danger">R$ @movimentacoes.Where(x => x.Natureza == "Saida").Sum(x => x.Valor).ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between fs-5">
                            <span class="text-dark fw-bold">Saldo Calculado:</span>
                            <span class="fw-bold text-success">R$ @caixaAtual?.SaldoFinalCalculado.ToString("F2")</span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-exchange-alt me-2"></i> Registrar Movimentação
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" @bind="tipoMovimentacaoSelecionada">
                                <option value="Sangria">Sangria (Retirada)</option>
                                <option value="Reforço">Reforço (Entrada)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valor (R$)</label>
                            <input type="number" class="form-control" @bind="valorMovimentacao" step="0.01" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Observação</label>
                            <input type="text" class="form-control" @bind="observacaoMovimentacao" />
                        </div>
                        <button class="btn btn-warning w-100 fw-bold" @onclick="RegistrarSangriaReforcoAsync">Gravar</button>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white fw-bold">
                         <i class="fas fa-door-closed me-2"></i> Encerrar Turno / Fechar Caixa
                    </div>
                    <div class="card-body text-center">
                        <p class="small text-muted mb-2">Informe o valor real contado na gaveta para fechamento.</p>
                        <div class="input-group input-group-sm mb-3">
                            <span class="input-group-text">R$</span>
                            <input type="number" class="form-control text-end" @bind="saldoInformadoFinal" step="0.01" />
                        </div>
                        <button class="btn btn-outline-danger w-100" @onclick="FecharCaixaAsync">Efetuar Fechamento</button>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Histórico de Movimentações (Turno Atual)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 500px">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Hora</th>
                                        <th>Operação</th>
                                        <th>Tipo</th>
                                        <th class="text-end">R$ Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if(movimentacoes == null || !movimentacoes.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted p-3">Nenhuma movimentação.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var mov in movimentacoes.OrderByDescending(x => x.DataHora))
                                        {
                                            <tr>
                                                <td>@mov.DataHora.ToString("HH:mm")</td>
                                                <td>
                                                    <strong>@mov.TipoMovimentacao</strong><br/>
                                                    <small class="text-muted">@mov.Descricao</small>
                                                </td>
                                                <td>
                                                    @if(mov.Natureza == "Entrada") { <span class="badge bg-success">Entrada</span> }
                                                    else if(mov.Natureza == "Saida") { <span class="badge bg-danger">Saída</span> }
                                                    else { <span class="badge bg-secondary">Info</span> }
                                                </td>
                                                <td class="text-end align-middle fw-bold">
                                                    @(mov.Natureza == "Saida" ? "-" : "")@mov.Valor.ToString("F2")
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool CaixaAberto = false;
    private MCaixa? caixaAtual;
    private List<MMovimentacaoCaixa> movimentacoes = new();

    private double saldoInicial = 0.0;
    private double saldoInformadoFinal = 0.0;

    private string tipoMovimentacaoSelecionada = "Sangria";
    private double valorMovimentacao = 0.0;
    private string observacaoMovimentacao = "";

    private string mensagemAlerta = "";
    private string classeAlerta = "alert-success";

    private string CurrentUserId = "1"; // Mocked Worker ID

    protected override async Task OnInitializedAsync()
    {
        await CarregarSituacaoCaixaAsync();
    }

    private async Task CarregarSituacaoCaixaAsync()
    {
        var result = await CaixaLogic.ObterCaixaAbertoAsync();
        CaixaAberto = result.Sucesso;

        if (CaixaAberto)
        {
            var all = await MovimentacaoCaixaService.GetAll();
            movimentacoes = (all ?? Enumerable.Empty<MMovimentacaoCaixa>())
                .Where(m => m.CaixaId == caixaAtual?.Id.ToString())
                .ToList();
            // Set suggested final balance to calculated balance
            saldoInformadoFinal = caixaAtual?.SaldoFinalCalculado ?? 0;
        }
        else
        {
            caixaAtual = null;
            movimentacoes.Clear();
        }
    }

    private async Task AbrirCaixaAsync()
    {
        LimparAlerta();
        var result = await CaixaLogic.AbrirCaixaAsync(CurrentUserId, saldoInicial, "Opeador logado via PDV");
        
        if (result.Sucesso)
        {
            ExibirAlerta(result.Mensagem, "alert-success");
            await CarregarSituacaoCaixaAsync();
        }
        else
        {
            ExibirAlerta(result.Mensagem, "alert-danger");
        }
    }

    private async Task RegistrarSangriaReforcoAsync()
    {
        LimparAlerta();
        if (valorMovimentacao <= 0)
        {
             ExibirAlerta("Valor deve ser maior que zero.", "alert-warning");
             return;
        }

        string natureza = tipoMovimentacaoSelecionada == "Sangria" ? "Saida" : "Entrada";
        
        // Log movement and adjust balance via logic
        await CaixaLogic.RegistrarMovimentacaoAsync(
            caixaAtual!.Id.ToString(),
            CurrentUserId,
            tipoMovimentacaoSelecionada,
            natureza,
            valorMovimentacao,
            "Dinheiro", // By definition usually Sangria/Reforco occurs in physical cash.
            observacaoMovimentacao
        );

        ExibirAlerta($"{tipoMovimentacaoSelecionada} de R$ {valorMovimentacao:F2} registrada com sucesso.", "alert-success");
        
        valorMovimentacao = 0;
        observacaoMovimentacao = "";
        await CarregarSituacaoCaixaAsync();
    }

    private async Task FecharCaixaAsync()
    {
        LimparAlerta();
        var result = await CaixaLogic.FecharCaixaAsync(caixaAtual!.Id.ToString(), CurrentUserId, saldoInformadoFinal, "Fechamento manual");
        
        if (result.Sucesso)
        {
             ExibirAlerta(result.Mensagem, "alert-success");
             saldoInicial = 0;
             await CarregarSituacaoCaixaAsync();
        }
        else
        {
            ExibirAlerta(result.Mensagem, "alert-danger");
        }
    }

    private void ExibirAlerta(string mensagem, string classe)
    {
        mensagemAlerta = mensagem;
        classeAlerta = classe;
    }

    private void LimparAlerta()
    {
        mensagemAlerta = "";
    }
}
