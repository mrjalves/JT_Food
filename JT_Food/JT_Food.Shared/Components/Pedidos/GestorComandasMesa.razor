@using JT_Classes.Restaurante
@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Domain.Enums
@using JT_Food.Shared.Services.Interfaces
@inject IComandaService ComandaService
@inject CaixaLogic CaixaLogic
@inject NavigationManager Navigation

<div class="gestor-comandas-mesa card border-0 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
        <div>
            <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3-fill me-2"></i>Comandas da @MesaIdentificacao</h5>
            <small class="opacity-75">@(comandasDaMesa.Count) comanda(s) aberta(s) nesta mesa</small>
        </div>
        <button class="btn btn-sm @(caixaAberto ? "btn-light text-primary fw-bold" : "btn-secondary text-white disabled opacity-75")"
                @onclick="AbrirFormularioNovaComanda"
                disabled="@(!caixaAberto)"
                title="@(!caixaAberto ? "Abra o caixa no menu Caixa & PDV para abrir comandas" : "Nova Comanda")">
            <i class="bi @(caixaAberto ? "bi-plus-circle" : "bi-lock-fill") me-1"></i> Nova Comanda
        </button>
    </div>

    @if (!caixaAberto)
    {
        <div class="alert alert-warning border-warning m-3 d-flex align-items-center justify-content-between p-3 shadow-sm rounded-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                <div>
                    <strong class="d-block text-dark">Caixa Fechado</strong>
                    <span class="text-muted small">Não é possível abrir novas comandas para a @MesaIdentificacao com o caixa fechado.</span>
                </div>
            </div>
            <button class="btn btn-warning btn-sm text-dark fw-bold px-3 shadow-sm" @onclick='() => Navigation.NavigateTo("/caixa")'>
                <i class="bi bi-cash-stack me-1"></i> Abrir Caixa
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(erroCaixa))
    {
        <div class="alert alert-danger alert-dismissible fade show m-3 p-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            @erroCaixa
            <button type="button" class="btn-close" @onclick="() => erroCaixa = null"></button>
        </div>
    }

    <!-- Formulário Unificado de Nova Comanda Vinculada à Mesa -->
    @if (abrindoNovaComanda)
    {
        <div class="card-body bg-light border-bottom p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-3 py-2 fs-6">
                        <i class="bi bi-geo-alt-fill me-1"></i> Mesa Vinculada: <strong>@MesaIdentificacao</strong>
                        <i class="bi bi-lock-fill ms-1 small opacity-75" title="Mesa vinculada automaticamente"></i>
                    </span>
                    <h6 class="mb-0 fw-bold text-dark">Abertura de Comanda</h6>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarAberturaComanda" disabled="@abrindo">
                    <i class="bi bi-x-lg me-1"></i> Cancelar
                </button>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Nº Cartão / Identificador:</label>
                    <input type="text" class="form-control" placeholder="Ex: 105" @bind="novoNumeroCartao" disabled="@abrindo" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Nome do Cliente:</label>
                    <input type="text" class="form-control" placeholder="Ex: João Silva" @bind="novoNomeCliente" disabled="@abrindo" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Mesa Vinculada (Fixa):</label>
                    <input type="text" class="form-control bg-white fw-bold text-primary" value="@MesaIdentificacao" disabled readonly />
                </div>

                <!-- Couvert Artístico -->
                <div class="col-12">
                    <div class="card bg-white border p-3">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="checkCouvertMesa" @bind="cobrarCouvert" disabled="@abrindo" />
                            <label class="form-check-label fw-bold text-dark" for="checkCouvertMesa">
                                <i class="bi bi-music-note-beamed text-primary me-1"></i> Cobrar Couvert Artístico
                            </label>
                        </div>
                        @if (cobrarCouvert)
                        {
                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small text-muted mb-1">Qtd Pessoas:</label>
                                    <input type="number" class="form-control form-control-sm" @bind="quantidadePessoas" min="1" max="50" disabled="@abrindo" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label small text-muted mb-1">Valor por Pessoa (R$):</label>
                                    <input type="number" class="form-control form-control-sm text-end" @bind="valorCouvertUnitario" step="1.00" min="0" disabled="@abrindo" />
                                </div>
                                <div class="col-12 text-end mt-1">
                                    <small class="text-primary fw-bold">Total Couvert: R$ @((quantidadePessoas * valorCouvertUnitario).ToString("F2"))</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Botões de Ação -->
                <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelarAberturaComanda" disabled="@abrindo">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-success fw-bold px-4" @onclick="ConfirmarAberturaComandaAsync" disabled="@abrindo">
                        @if (abrindo)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Abrindo...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <span>Abrir Comanda na @MesaIdentificacao</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Lista de Comandas da Mesa -->
    <div class="card-body p-0">
        @if (carregando)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                <span class="text-muted ms-2">Buscando comandas...</span>
            </div>
        }
        else if (!comandasDaMesa.Any() && !abrindoNovaComanda)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt fs-1 opacity-25"></i>
                <p class="mt-2 mb-3">Nenhuma comanda vinculada a esta mesa.</p>
                @if (caixaAberto)
                {
                    <button class="btn btn-primary btn-sm px-3 fw-bold" @onclick="AbrirFormularioNovaComanda">
                        <i class="bi bi-plus-lg me-1"></i> Abrir Primeira Comanda
                    </button>
                }
                else
                {
                    <button class="btn btn-warning btn-sm px-3 fw-bold text-dark" @onclick='() => Navigation.NavigateTo("/caixa")'>
                        <i class="bi bi-cash-stack me-1"></i> Abrir Caixa para Iniciar
                    </button>
                }
            </div>
        }
        else if (comandasDaMesa.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var c in comandasDaMesa)
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 me-3 fs-5">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-6">
                                    @(string.IsNullOrWhiteSpace(c.NomeCliente) ? $"Comanda #{c.Id}" : c.NomeCliente)
                                </div>
                                <small class="text-muted">
                                    Aberta às @c.DataAbertura.ToString("HH:mm") | Status: <span class="badge bg-success">@c.Status</span>
                                    @if (c.TaxaServico > 0)
                                    {
                                        <span class="badge bg-info text-dark ms-1">Couvert R$ @c.TaxaServico.ToString("F2")</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5 fw-bold text-success me-2">R$ @c.Total.ToString("F2")</span>

                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SelecionarParaLancarPedido(c)" title="Registrar Pedido">
                                <i class="bi bi-plus-lg me-1"></i> Pedido
                            </button>
                            <button class="btn btn-sm btn-outline-success" @onclick="() => IrParaFechamento(c.Id)" title="Fechar e Pagar">
                                <i class="bi bi-cash-coin me-1"></i> Fechar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Total Consolidado da Mesa -->
    <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="text-muted d-block small">Total Acumulado da Mesa:</span>
            <span class="fs-4 fw-bold text-dark">R$ @TotalMesa.ToString("F2")</span>
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-dark btn-sm" @onclick="RecarregarAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string MesaIdentificacao { get; set; } = string.Empty;
    [Parameter] public EventCallback<JT_Classes.Restaurante.Comanda> OnSelecionarComanda { get; set; }
    [Parameter] public EventCallback OnComandaCriada { get; set; }

    private List<JT_Classes.Restaurante.Comanda> comandasDaMesa = new();
    private bool carregando = true;
    private bool abrindoNovaComanda = false;
    private bool abrindo = false;
    private bool caixaAberto = true;
    private string? erroCaixa;
    private string novoNumeroCartao = "";
    private string novoNomeCliente = "";
    private bool cobrarCouvert = false;
    private int quantidadePessoas = 1;
    private double valorCouvertUnitario = 15.00;

    protected override async Task OnParametersSetAsync()
    {
        await RecarregarAsync();
    }

    public async Task RecarregarAsync()
    {
        carregando = true;
        var statusCaixa = await CaixaLogic.ObterCaixaAbertoAsync();
        caixaAberto = statusCaixa.Sucesso;
        if (!string.IsNullOrWhiteSpace(MesaIdentificacao))
        {
            comandasDaMesa = await ComandaService.ObterComandasDaMesaAsync(MesaIdentificacao);
        }
        carregando = false;
        StateHasChanged();
    }

    private void AbrirFormularioNovaComanda()
    {
        if (!caixaAberto)
        {
            erroCaixa = "Não é possível abrir comandas enquanto o caixa estiver fechado.";
            return;
        }
        erroCaixa = null;
        abrindoNovaComanda = true;
    }

    private void CancelarAberturaComanda()
    {
        abrindoNovaComanda = false;
        novoNumeroCartao = "";
        novoNomeCliente = "";
        cobrarCouvert = false;
        quantidadePessoas = 1;
    }

    private double TotalMesa => comandasDaMesa.Sum(c => c.Total);

    private async Task ConfirmarAberturaComandaAsync()
    {
        if (abrindo) return;
        if (string.IsNullOrWhiteSpace(novoNumeroCartao) && string.IsNullOrWhiteSpace(novoNomeCliente))
        {
            return;
        }

        var statusCaixa = await CaixaLogic.ObterCaixaAbertoAsync();
        caixaAberto = statusCaixa.Sucesso;
        if (!caixaAberto)
        {
            erroCaixa = "Não é possível abrir comandas: o caixa está fechado. Por favor, abra o caixa antes de criar atendimentos.";
            return;
        }

        try
        {
            abrindo = true;
            erroCaixa = null;
            StateHasChanged();

            var nova = await ComandaService.AbrirComandaFlexivelAsync(
                novoNumeroCartao,
                novoNomeCliente,
                MesaIdentificacao,
                quantidadePessoas,
                cobrarCouvert,
                valorCouvertUnitario
            );

            CancelarAberturaComanda();
            await RecarregarAsync();

            if (OnComandaCriada.HasDelegate)
            {
                await OnComandaCriada.InvokeAsync();
            }

            if (OnSelecionarComanda.HasDelegate)
            {
                await OnSelecionarComanda.InvokeAsync(nova);
            }
        }
        catch (InvalidOperationException ex)
        {
            erroCaixa = ex.Message;
        }
        catch (Exception ex)
        {
            erroCaixa = $"Erro ao abrir comanda: {ex.Message}";
        }
        finally
        {
            abrindo = false;
            StateHasChanged();
        }
    }

    private async Task SelecionarParaLancarPedido(JT_Classes.Restaurante.Comanda comanda)
    {
        if (OnSelecionarComanda.HasDelegate)
        {
            await OnSelecionarComanda.InvokeAsync(comanda);
        }
    }

    private void IrParaFechamento(int comandaId)
    {
        Navigation.NavigateTo($"/fechamento/{comandaId}");
    }
}
