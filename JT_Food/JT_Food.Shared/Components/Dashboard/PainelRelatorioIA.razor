@using JT_Food.Shared.BusinessLogic
@using JT_Food.Shared.Services.Interfaces
@inject RelatorioIALogic RelatorioLogic
@inject IIAAnalyticsService IAService

<div class="painel-relatorio-ia card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0 !important;">
    <div class="card-header text-white p-3 d-flex flex-wrap justify-content-between align-items-center"
         style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%); border-bottom: none;">
        <div>
            <h5 class="mb-0 fw-bold"><i class="bi bi-stars text-warning me-2"></i>Consultor Executivo IA — JT_Food Insights</h5>
            <small class="text-white-50">Diagnósticos inteligentes, otimização de cardápio e previsão de demanda</small>
        </div>
        <button class="btn btn-sm btn-light text-primary fw-bold shadow-sm rounded-pill px-3"
                @onclick='() => ExecutarGeracaoAsync(abaAtiva)'
                disabled="@gerando">
            @if (gerando)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Analisando Dados...</span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-1"></i>
                <span>Atualizar Diagnóstico</span>
            }
        </button>
    </div>

    <!-- Botões de Ações Rápidas -->
    <div class="card-body bg-light border-bottom p-2.5 d-flex flex-wrap gap-2 align-items-center">
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(abaAtiva == "geral" ? "btn-primary shadow-sm text-white" : "btn-outline-primary")"
                @onclick='() => ExecutarGeracaoAsync("geral")'
                disabled="@gerando">
            📊 Diagnóstico 360°
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(abaAtiva == "combos" ? "btn-danger shadow-sm text-white" : "btn-outline-danger")"
                @onclick='() => ExecutarGeracaoAsync("combos")'
                disabled="@gerando">
            🔥 Sugerir Combos & Happy Hour
        </button>
        <button class="btn btn-sm rounded-pill px-3 fw-semibold @(abaAtiva == "kds" ? "btn-success shadow-sm text-white" : "btn-outline-success")"
                @onclick='() => ExecutarGeracaoAsync("kds")'
                disabled="@gerando">
            🍳 Gargalos KDS & Compras
        </button>
    </div>

    <!-- Conteúdo do Relatório Gerado -->
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(erroGeracao))
        {
            <div class="alert alert-info alert-dismissible fade show p-2 mb-3 small" role="alert">
                <i class="bi bi-info-circle-fill me-1"></i> @erroGeracao
                <button type="button" class="btn-close btn-close-sm" @onclick="() => erroGeracao = null"></button>
            </div>
        }

        @if (gerando)
        {
            <div class="text-center py-5">
                <div class="spinner-grow text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold text-dark">A IA está processando as métricas de vendas, KDS e estoque...</h5>
                <p class="text-muted small">Cruzando dados de lucratividade, giro de mesas e tempos de preparo.</p>
            </div>
        }
        else if (string.IsNullOrEmpty(conteudoRelatorio))
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-robot fs-1 opacity-25"></i>
                <p class="mt-2 mb-3">Nenhum diagnóstico disponível no momento.</p>
                <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" @onclick='() => ExecutarGeracaoAsync("geral")'>
                    <i class="bi bi-stars me-1"></i> Gerar Primeiro Relatório
                </button>
            </div>
        }
        else
        {
            <div class="relatorio-conteudo p-4 bg-white rounded border shadow-sm">
                @((MarkupString)ConverterMarkdownParaHtml(conteudoRelatorio))
            </div>
        }
    </div>
</div>

<style>
    .relatorio-conteudo {
        font-family: inherit;
        line-height: 1.6;
        color: #334155;
    }
    .relatorio-conteudo h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 0.5rem;
        margin-bottom: 0.75rem;
    }
    .relatorio-conteudo h4 {
        font-size: 1.05rem;
        font-weight: 600;
        color: #2563eb;
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
    }
    .relatorio-conteudo ul {
        padding-left: 1.25rem;
        margin-bottom: 1rem;
    }
    .relatorio-conteudo li {
        margin-bottom: 0.35rem;
    }
    .relatorio-conteudo strong {
        color: #1e293b;
    }
</style>

@code {
    private string conteudoRelatorio = "";
    private bool gerando = false;
    private string abaAtiva = "geral";
    private string? erroGeracao;

    protected override async Task OnInitializedAsync()
    {
        await ExecutarGeracaoAsync("geral");
    }

    private async Task ExecutarGeracaoAsync(string tipo)
    {
        if (gerando) return;

        gerando = true;
        erroGeracao = null;
        abaAtiva = tipo;
        StateHasChanged();

        try
        {
            if (tipo == "combos")
            {
                conteudoRelatorio = await IAService.GerarSugestaoPromocoesAsync(
                    "Dados de vendas: Alto giro de Chopp e Burger, baixo giro de porções às quartas-feiras."
                );
            }
            else if (tipo == "kds")
            {
                conteudoRelatorio = await IAService.GerarDiagnosticoCozinhaEComprasAsync(
                    "KDS: Tempo médio Chapa = 12min, Cozinha = 19min. Horário de pico 20h30.",
                    "Estoque: Bacon Rústico = 2.4kg (mínimo 5kg), Queijo Gouda = 1.8kg (mínimo 4kg)."
                );
            }
            else
            {
                conteudoRelatorio = await RelatorioLogic.GerarRelatorioInteligenteAsync();
            }

            if (string.IsNullOrWhiteSpace(conteudoRelatorio))
            {
                conteudoRelatorio = await IAService.GerarDiagnosticoGeralAsync("Dados consolidados do restaurante");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PainelRelatorioIA] Erro na geração: {ex.Message}");
            erroGeracao = "Conexão com servidor de IA instável. Exibindo diagnóstico estratégico local.";
            try
            {
                conteudoRelatorio = await IAService.GerarDiagnosticoGeralAsync("Fallback");
            }
            catch { }
        }
        finally
        {
            gerando = false;
            StateHasChanged();
        }
    }

    private string ConverterMarkdownParaHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var lines = markdown.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();

            if (string.IsNullOrWhiteSpace(line))
            {
                if (inList)
                {
                    sb.AppendLine("</ul>");
                    inList = false;
                }
                continue;
            }

            if (line.StartsWith("### "))
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                string title = FormatarTextoInline(line.Substring(4));
                sb.AppendLine($"<h3 class=\"mt-3 mb-2 fw-bold text-dark border-bottom pb-2\"><i class=\"bi bi-chevron-right text-primary me-1 fs-6\"></i>{title}</h3>");
            }
            else if (line.StartsWith("#### "))
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                string subtitle = FormatarTextoInline(line.Substring(5));
                sb.AppendLine($"<h4 class=\"mt-3 mb-2 fw-semibold text-primary fs-6\">{subtitle}</h4>");
            }
            else if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                if (!inList)
                {
                    sb.AppendLine("<ul class=\"mb-3 ps-3\">");
                    inList = true;
                }
                string item = FormatarTextoInline(line.Substring(2));
                sb.AppendLine($"<li class=\"mb-1\">{item}</li>");
            }
            else
            {
                if (inList) { sb.AppendLine("</ul>"); inList = false; }
                string p = FormatarTextoInline(line);
                if (p.StartsWith("<em>") && p.EndsWith("</em>"))
                {
                    sb.AppendLine($"<p class=\"text-muted small mb-2\">{p}</p>");
                }
                else
                {
                    sb.AppendLine($"<p class=\"mb-2\">{p}</p>");
                }
            }
        }

        if (inList)
        {
            sb.AppendLine("</ul>");
        }

        return sb.ToString();
    }

    private string FormatarTextoInline(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        // Negrito: **texto**
        var rxBold = new System.Text.RegularExpressions.Regex(@"\*\*(.+?)\*\*");
        text = rxBold.Replace(text, "<strong>$1</strong>");

        // Itálico: *texto*
        var rxItalic = new System.Text.RegularExpressions.Regex(@"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)");
        text = rxItalic.Replace(text, "<em>$1</em>");

        return text;
    }
}
