@using JT_Classes.Restaurante
@using JT_Food.Shared.Components.Pedidos
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Domain.Enums
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Restaurante
@using JT_UserInterface.Shared.Components.Core
@inject MesaService MesaService
@inject IComandaService ComandaService
@inject ItemComandaService ItemComandaService

<Modal @ref="modalRef" Title="@(Comanda.Id == 0 ? "Abertura de Nova Comanda" : $"Comanda #{Comanda.Id} — {Comanda.NomeCliente}")" Size="Modal.ModalSize.ExtraLarge" EntidadeContexto="Comanda">
    <BodyContent>
        @if (Comanda.Id > 0)
        {
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "dados" ? "active fw-bold" : "")" @onclick='() => MudarAba("dados")'>
                        <i class="bi bi-info-circle me-1"></i> Dados & Couvert
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "pedidos" ? "active fw-bold text-primary" : "")" @onclick='() => MudarAba("pedidos")'>
                        <i class="bi bi-cart-plus me-1"></i> Lançar Pedidos
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "itens" ? "active fw-bold text-success" : "")" @onclick='() => MudarAba("itens")'>
                        <i class="bi bi-receipt me-1"></i> Itens Pedidos (@itensComanda.Count)
                    </button>
                </li>
            </ul>
        }

        @if (abaAtiva == "pedidos" && Comanda.Id > 0)
        {
            <LancamentoRapido MesaIdentificacao="@Comanda.MesaId"
                              ComandaAtiva="comandaParaPedido"
                              OnPedidoEnviado="HandlePedidoEnviado" />
        }
        else if (abaAtiva == "itens" && Comanda.Id > 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt text-primary me-2"></i>Itens Registrados nesta Comanda</h6>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CarregarItensAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i> Atualizar Itens
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (carregandoItens)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                            <span class="text-muted ms-2">Carregando itens...</span>
                        </div>
                    }
                    else if (!itensComanda.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-cart-x fs-1 opacity-25"></i>
                            <p class="mt-2 mb-0">Nenhum item lançado ainda nesta comanda.</p>
                            <button class="btn btn-sm btn-primary mt-3" @onclick='() => MudarAba("pedidos")'>
                                <i class="bi bi-cart-plus me-1"></i> Adicionar Produtos
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produto</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">Preço Unit.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Status KDS</th>
                                        <th>Observações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itensComanda)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@item.NomeProduto</td>
                                            <td class="text-center"><span class="badge bg-secondary">@item.Quantidade</span></td>
                                            <td class="text-end text-muted">R$ @item.PrecoUnitario.ToString("F2")</td>
                                            <td class="text-end fw-bold text-success">R$ @item.TotalItem.ToString("F2")</td>
                                            <td class="text-center">
                                                <span class="badge @ObterClasseStatusItem(item.Status)">@item.Status</span>
                                            </td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.Observacao) ? "-" : item.Observacao)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-end">Subtotal de Produtos:</td>
                                        <td class="text-end text-success fs-6">R$ @itensComanda.Sum(i => i.TotalItem).ToString("F2")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                <!-- Número do Cartão -->
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold text-muted small">Nº Cartão / Comanda:</label>
                    <input type="text" class="form-control" placeholder="Ex: 105" @bind="numeroCartao" />
                </div>

                <!-- Nome do Cliente -->
                <div class="col-12 col-md-8">
                    <label class="form-label fw-bold text-muted small">Nome do Cliente:</label>
                    <input type="text" class="form-control" placeholder="Ex: João Silva" @bind="nomeCliente" />
                </div>

                <!-- Mesa Vinculada -->
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-muted small">Mesa Vinculada:</label>
                    <select class="form-select" @bind="Comanda.MesaId">
                        <option value="">(Balcão / Sem Mesa Fixa)</option>
                        @foreach (var m in mesas)
                        {
                            <option value="@m.Identificacao">@m.Identificacao (@m.Status)</option>
                        }
                    </select>
                </div>

                <!-- Status -->
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-muted small">Status:</label>
                    <select class="form-select" @bind="Comanda.Status">
                        <option value="Aberta">Aberta</option>
                        <option value="AguardandoPagamento">Aguardando Pagamento</option>
                        <option value="Fechada">Fechada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>

                <!-- Controle de Couvert Artístico -->
                <div class="col-12">
                    <div class="card bg-light border p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="checkCouvert" @bind="cobrarCouvert" />
                                <label class="form-check-label fw-bold text-dark" for="checkCouvert">
                                    <i class="bi bi-music-note-beamed text-primary me-1"></i> Cobrar Couvert Artístico
                                </label>
                            </div>
                        </div>

                        @if (cobrarCouvert)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <label class="form-label small text-muted">Qtd Pessoas:</label>
                                    <input type="number" class="form-control form-control-sm" @bind="quantidadePessoas" min="1" max="50" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted">Valor por Pessoa (R$):</label>
                                    <input type="number" class="form-control form-control-sm text-end" @bind="valorCouvertUnitario" step="0.50" />
                                </div>
                                <div class="col-12 text-end mt-1">
                                    <small class="text-primary fw-bold">Total Couvert: R$ @((quantidadePessoas * valorCouvertUnitario).ToString("F2"))</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@salvando">Cancelar</button>
                <button type="button" class="btn btn-success" @onclick="SalvarAsync" disabled="@salvando">
                    @if (salvando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <i class="fas fa-save me-1"></i>
                        <span>Salvar Comanda</span>
                    }
                </button>
            </div>
        }
    </BodyContent>
</Modal>

@code {
    [Parameter] public JT_Classes.Restaurante.Comanda Comanda { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private Modal modalRef = default!;
    private List<JT_Classes.Restaurante.Mesa> mesas = new();
    private string abaAtiva = "dados";

    private string numeroCartao = "";
    private string nomeCliente = "";
    private bool cobrarCouvert = false;
    private int quantidadePessoas = 1;
    private double valorCouvertUnitario = 15.00;

    private JT_Food.Shared.Domain.Entities.Comanda? comandaParaPedido;
    private List<MItemComanda> itensComanda = new();
    private bool carregandoItens = false;

    protected override async Task OnInitializedAsync()
    {
        var todas = await MesaService.GetAll();
        mesas = todas ?? new();
    }

    public void Open(JT_Classes.Restaurante.Comanda? comanda = null, string aba = "dados")
    {
        if (comanda != null)
        {
            Comanda = comanda;
        }

        abaAtiva = Comanda.Id == 0 ? "dados" : aba;

        // Extrai dados se já formatado
        numeroCartao = "";
        nomeCliente = Comanda.NomeCliente ?? "";
        if (nomeCliente.Contains("[Cartão ") && nomeCliente.Contains("]"))
        {
            var parts = nomeCliente.Split(']');
            numeroCartao = parts[0].Replace("[Cartão ", "").Trim();
            nomeCliente = parts.Length > 1 ? parts[1].Trim() : "";
        }
        else if (nomeCliente.StartsWith("Cartão #"))
        {
            numeroCartao = nomeCliente.Replace("Cartão #", "").Trim();
            nomeCliente = "";
        }

        cobrarCouvert = Comanda.TaxaServico > 0;
        quantidadePessoas = 1;

        if (Comanda.Id > 0)
        {
            comandaParaPedido = new JT_Food.Shared.Domain.Entities.Comanda
            {
                Id = Comanda.Id,
                NomeCliente = Comanda.NomeCliente,
                MesaId = Comanda.MesaId,
                Subtotal = Comanda.Total
            };
            _ = CarregarItensAsync();
        }

        modalRef.Open();
    }

    public void Close() => modalRef.Close();
    public bool IsOpen => modalRef.IsOpen;

    private async Task MudarAba(string aba)
    {
        abaAtiva = aba;
        if (aba == "itens")
        {
            await CarregarItensAsync();
        }
    }

    private async Task CarregarItensAsync()
    {
        if (Comanda.Id <= 0) return;
        carregandoItens = true;
        try
        {
            var all = await ItemComandaService.GetAll();
            string cid = Comanda.Id.ToString();
            itensComanda = (all ?? Enumerable.Empty<MItemComanda>())
                .Where(i => !string.IsNullOrWhiteSpace(i.ComandaId) &&
                            (i.ComandaId == cid || i.ComandaId.Trim().TrimStart('#') == cid))
                .OrderByDescending(i => i.Id)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModalComanda CarregarItensAsync Error]: {ex.Message}");
        }
        finally
        {
            carregandoItens = false;
        }
        StateHasChanged();
    }

    private bool salvando = false;

    public async Task SalvarAsync()
    {
        if (salvando) return;
        salvando = true;
        StateHasChanged();

        try
        {
            if (Comanda.Id == 0)
            {
                var nova = await ComandaService.AbrirComandaFlexivelAsync(
                    numeroCartao,
                    nomeCliente,
                    Comanda.MesaId,
                    quantidadePessoas,
                    cobrarCouvert,
                    valorCouvertUnitario
                );
                Comanda = nova;
            }
            else
            {
                // Atualizar
                string formatado = "";
                if (!string.IsNullOrWhiteSpace(numeroCartao) && !string.IsNullOrWhiteSpace(nomeCliente))
                    formatado = $"[Cartão {numeroCartao}] {nomeCliente}";
                else if (!string.IsNullOrWhiteSpace(numeroCartao))
                    formatado = $"Cartão #{numeroCartao}";
                else if (!string.IsNullOrWhiteSpace(nomeCliente))
                    formatado = nomeCliente;
                else
                    formatado = "Consumidor";

                Comanda.NomeCliente = formatado;

                if (cobrarCouvert)
                {
                    Comanda.TaxaServico = quantidadePessoas * valorCouvertUnitario;
                }

                await ComandaService.SaveAsync(Comanda);
            }

            await OnSaved.InvokeAsync();
            Close();
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task HandlePedidoEnviado()
    {
        if (Comanda.Id > 0)
        {
            var cAtualizada = await ComandaService.GetByIdAsync(Comanda.Id);
            if (cAtualizada != null)
            {
                Comanda = cAtualizada;
                if (comandaParaPedido != null)
                {
                    comandaParaPedido.Subtotal = cAtualizada.Total;
                }
            }
            await CarregarItensAsync();
        }
        await OnSaved.InvokeAsync();
        StateHasChanged();
    }

    private string ObterClasseStatusItem(string status)
    {
        return status switch
        {
            "Confirmado" => "bg-primary",
            "Em Produção" => "bg-warning text-dark",
            "Pronto" => "bg-info text-dark",
            "Saída para Entrega" => "bg-secondary",
            "Entregue" => "bg-success",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
