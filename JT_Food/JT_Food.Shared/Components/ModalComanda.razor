@using JT_Classes.Restaurante
@using JT_Food.Shared.Components.Pedidos
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Domain.Enums
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Restaurante
@using JT_UserInterface.Shared.Components.Core
@inject MesaService MesaService
@inject IComandaService ComandaService

<Modal @ref="modalRef" Title="@(Comanda.Id == 0 ? "Abertura de Nova Comanda" : $"Comanda #{Comanda.Id} — {Comanda.NomeCliente}")" EntidadeContexto="Comanda">
    <BodyContent>
        @if (Comanda.Id > 0)
        {
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "dados" ? "active fw-bold" : "")" @onclick='() => abaAtiva = "dados"'>
                        <i class="bi bi-info-circle me-1"></i> Dados & Couvert
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "pedidos" ? "active fw-bold text-primary" : "")" @onclick='() => abaAtiva = "pedidos"'>
                        <i class="bi bi-cart-plus me-1"></i> Lançar Pedidos
                    </button>
                </li>
            </ul>
        }

        @if (abaAtiva == "pedidos" && Comanda.Id > 0)
        {
            <LancamentoRapido MesaIdentificacao="@Comanda.MesaId"
                              ComandaAtiva="comandaParaPedido"
                              OnPedidoEnviado="HandlePedidoEnviado" />
        }
        else
        {
            <div class="row g-3">
                <!-- Número do Cartão -->
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold text-muted small">Nº Cartão / Comanda:</label>
                    <input type="text" class="form-control" placeholder="Ex: 105" @bind="numeroCartao" />
                </div>

                <!-- Nome do Cliente -->
                <div class="col-12 col-md-8">
                    <label class="form-label fw-bold text-muted small">Nome do Cliente:</label>
                    <input type="text" class="form-control" placeholder="Ex: João Silva" @bind="nomeCliente" />
                </div>

                <!-- Mesa Vinculada -->
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-muted small">Mesa Vinculada:</label>
                    <select class="form-select" @bind="Comanda.MesaId">
                        <option value="">(Balcão / Sem Mesa Fixa)</option>
                        @foreach (var m in mesas)
                        {
                            <option value="@m.Identificacao">@m.Identificacao (@m.Status)</option>
                        }
                    </select>
                </div>

                <!-- Status -->
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-muted small">Status:</label>
                    <select class="form-select" @bind="Comanda.Status">
                        <option value="Aberta">Aberta</option>
                        <option value="AguardandoPagamento">Aguardando Pagamento</option>
                        <option value="Fechada">Fechada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>

                <!-- Controle de Couvert Artístico -->
                <div class="col-12">
                    <div class="card bg-light border p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="checkCouvert" @bind="cobrarCouvert" />
                                <label class="form-check-label fw-bold text-dark" for="checkCouvert">
                                    <i class="bi bi-music-note-beamed text-primary me-1"></i> Cobrar Couvert Artístico
                                </label>
                            </div>
                        </div>

                        @if (cobrarCouvert)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <label class="form-label small text-muted">Qtd Pessoas:</label>
                                    <input type="number" class="form-control form-control-sm" @bind="quantidadePessoas" min="1" max="50" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted">Valor por Pessoa (R$):</label>
                                    <input type="number" class="form-control form-control-sm text-end" @bind="valorCouvertUnitario" step="0.50" />
                                </div>
                                <div class="col-12 text-end mt-1">
                                    <small class="text-primary fw-bold">Total Couvert: R$ @((quantidadePessoas * valorCouvertUnitario).ToString("F2"))</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button type="button" class="btn btn-success" @onclick="SalvarAsync">
                    <i class="fas fa-save me-1"></i> Salvar Comanda
                </button>
            </div>
        }
    </BodyContent>
</Modal>

@code {
    [Parameter] public JT_Classes.Restaurante.Comanda Comanda { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private Modal modalRef = default!;
    private List<JT_Classes.Restaurante.Mesa> mesas = new();
    private string abaAtiva = "dados";

    private string numeroCartao = "";
    private string nomeCliente = "";
    private bool cobrarCouvert = false;
    private int quantidadePessoas = 1;
    private double valorCouvertUnitario = 15.00;

    private JT_Food.Shared.Domain.Entities.Comanda? comandaParaPedido;

    protected override async Task OnInitializedAsync()
    {
        var todas = await MesaService.GetAll();
        mesas = todas ?? new();
    }

    public void Open(string aba = "dados")
    {
        abaAtiva = Comanda.Id == 0 ? "dados" : aba;

        // Extrai dados se já formatado
        numeroCartao = "";
        nomeCliente = Comanda.NomeCliente ?? "";
        if (nomeCliente.Contains("[Cartão ") && nomeCliente.Contains("]"))
        {
            var parts = nomeCliente.Split(']');
            numeroCartao = parts[0].Replace("[Cartão ", "").Trim();
            nomeCliente = parts.Length > 1 ? parts[1].Trim() : "";
        }

        cobrarCouvert = Comanda.TaxaServico > 0;
        quantidadePessoas = 1;

        if (Comanda.Id > 0)
        {
            comandaParaPedido = new JT_Food.Shared.Domain.Entities.Comanda
            {
                Id = Comanda.Id,
                NomeCliente = Comanda.NomeCliente,
                MesaId = Comanda.MesaId,
                Subtotal = Comanda.Total
            };
        }

        modalRef.Open();
    }

    public void Close() => modalRef.Close();
    public bool IsOpen => modalRef.IsOpen;

    public async Task SalvarAsync()
    {
        if (Comanda.Id == 0)
        {
            await ComandaService.AbrirComandaFlexivelAsync(
                numeroCartao,
                nomeCliente,
                Comanda.MesaId,
                quantidadePessoas,
                cobrarCouvert,
                valorCouvertUnitario
            );
        }
        else
        {
            // Atualizar
            string formatado = "";
            if (!string.IsNullOrWhiteSpace(numeroCartao) && !string.IsNullOrWhiteSpace(nomeCliente))
                formatado = $"[Cartão {numeroCartao}] {nomeCliente}";
            else if (!string.IsNullOrWhiteSpace(numeroCartao))
                formatado = $"Cartão #{numeroCartao}";
            else if (!string.IsNullOrWhiteSpace(nomeCliente))
                formatado = nomeCliente;
            else
                formatado = "Consumidor";

            Comanda.NomeCliente = formatado;

            if (cobrarCouvert)
            {
                Comanda.TaxaServico = quantidadePessoas * valorCouvertUnitario;
            }

            await ComandaService.SaveAsync(Comanda);
        }

        await OnSaved.InvokeAsync();
        Close();
    }

    private async Task HandlePedidoEnviado()
    {
        await OnSaved.InvokeAsync();
    }
}
