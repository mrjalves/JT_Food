@using JT_Classes.Restaurante
@using JT_Food.Shared.Services
@using JT_UserInterface.Shared.Components.Core

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-3x3 me-2 text-primary"></i>Mapa de Mesas</h5>
    </div>
    <div class="card-body p-0">
        <DataGrid TItem="Mesa" 
                  Items="Mesas" 
                  IsLoading="IsLoading" 
                  EnableRowClick="true"
                  OnRowClick="HandleRowClick"
                  UseServerPagination="false">
            <HeaderTemplate>
                <th>Identificação</th>
                <th>Capacidade</th>
                <th>Status</th>
                <th class="text-end">Ações</th>
            </HeaderTemplate>
            <RowTemplate Context="mesa">
                <td>@mesa.Identificacao</td>
                <td>@mesa.Capacidade</td>
                <td>
                    <span class="badge @GetStatusClass(mesa.Status)">@mesa.Status</span>
                </td>
                <td class="text-end" @onclick:stopPropagation="true">
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OnEdit.InvokeAsync(mesa)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(mesa)"><i class="bi bi-trash"></i></button>
                </td>
            </RowTemplate>
        </DataGrid>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Mesa>? Mesas { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<Mesa> OnEdit { get; set; }
    [Parameter] public EventCallback<Mesa> OnDelete { get; set; }

    private async Task HandleRowClick(Mesa mesa)
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(mesa);
        }
    }

    private string GetStatusClass(string status) => status switch
    {
        StatusMesa.Livre => "bg-success",
        StatusMesa.Ocupada => "bg-danger",
        StatusMesa.AguardandoPagamento => "bg-warning text-dark",
        StatusMesa.Reservada => "bg-info",
        _ => "bg-secondary"
    };
}
