@using JT_Food.Shared.Models
@using JT_Food.Shared.Services
@using JT_Food.Shared.Components

<GridGenerica TItem="MComanda" 
              Title="Controle de Comandas" 
              Items="Comandas" 
              IsLoading="IsLoading" 
              OnEdit="OnEdit" 
              OnDelete="OnDelete"
              SearchPredicate="@((c, term) => (c.NomeCliente?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) || c.Id.ToString().Contains(term))">
    <HeaderTemplate>
        <th>ID</th>
        <th>Mesa</th>
        <th>Cliente</th>
        <th>Abertura</th>
        <th class="text-end">Total</th>
        <th>Status</th>
    </HeaderTemplate>
    <RowTemplate Context="c">
        <td>#@c.Id</td>
        <td>@(string.IsNullOrEmpty(c.MesaId) ? "S/ Mesa" : $"Mesa {c.MesaId}")</td>
        <td>@(c.NomeCliente ?? "Consumidor")</td>
        <td>@c.DataAbertura.ToString("HH:mm")</td>
        <td class="text-end fw-bold text-success">R$ @c.Total.ToString("F2")</td>
        <td>
            <span class="badge @(c.Status == "Aberta" ? "bg-primary" : "bg-secondary")">@c.Status</span>
        </td>
    </RowTemplate>
    <HeaderActions>
         <div class="btn-group me-2">
            <button class="btn btn-sm btn-outline-info active">Todas</button>
            <button class="btn btn-sm btn-outline-info">Abertas</button>
        </div>
    </HeaderActions>
</GridGenerica>

@code {
    [Parameter] public IEnumerable<MComanda>? Comandas { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<MComanda> OnEdit { get; set; }
    [Parameter] public EventCallback<MComanda> OnDelete { get; set; }
}
