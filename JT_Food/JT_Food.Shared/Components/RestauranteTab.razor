@using JT_Food.Shared.Models
@using JT_Classes.Comum
@using Microsoft.AspNetCore.Components.Forms

@if (Model is MConfiguracao foodConfig)
{
    <h5 class="card-title">Configurações do Restaurante</h5>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Nome do Restaurante</label>
            <InputText class="form-control" @bind-Value="foodConfig.NomeRestaurante" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">CNPJ</label>
            <InputText class="form-control" @bind-Value="foodConfig.Cnpj" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 mb-3">
            <label class="form-label">Endereço</label>
            <InputText class="form-control" @bind-Value="foodConfig.Endereco" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Telefone</label>
            <InputText class="form-control" @bind-Value="foodConfig.Telefone" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Taxa de Serviço Padrão (%)</label>
            <InputNumber class="form-control" @bind-Value="foodConfig.TaxaServicoPadrao" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="form-check form-switch">
                <InputCheckbox class="form-check-input" id="switchEstoque" @bind-Value="foodConfig.PermiteEstoqueNegativo" />
                <label class="form-check-label" for="switchEstoque">Permitir estoque negativo</label>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        As configurações do restaurante não estão disponíveis para este modelo de dados.
    </div>
}

@code {
    [CascadingParameter]
    public Configuracao? Model { get; set; }
}
