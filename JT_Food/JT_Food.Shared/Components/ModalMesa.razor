@using JT_Classes.Restaurante
@using JT_Food.Shared.Components.Pedidos
@using JT_Food.Shared.Domain.Entities
@using JT_Food.Shared.Domain.Enums
@using JT_Food.Shared.Services.Interfaces
@using JT_Servicos.Restaurante
@using JT_UserInterface.Shared.Components.Core
@inject MesaService MesaService
@inject ItemComandaService ItemComandaService
@inject IComandaService ComandaService

<Modal @ref="modalRef" Title="@(Mesa.Id == 0 ? "Nova Mesa" : $"Operação: {Mesa.Identificacao} ({Mesa.Status})")" Size="Modal.ModalSize.ExtraLarge" EntidadeContexto="Mesa">
    <BodyContent>
        @if (Mesa.Id > 0)
        {
            <!-- Abas de Operação da Mesa -->
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "comandas" ? "active fw-bold" : "")" @onclick='() => MudarAba("comandas")'>
                        <i class="bi bi-diagram-3 me-1"></i> Comandas da Mesa
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "pedido" ? "active fw-bold text-primary" : "")" @onclick='() => MudarAba("pedido")'>
                        <i class="bi bi-cart-plus me-1"></i> Lançar Pedido
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "consumo" ? "active fw-bold text-success" : "")" @onclick='() => MudarAba("consumo")'>
                        <i class="bi bi-receipt me-1"></i> Itens Pedidos (@itensMesa.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(abaAtiva == "dados" ? "active fw-bold text-secondary" : "")" @onclick='() => MudarAba("dados")'>
                        <i class="bi bi-gear me-1"></i> Dados da Mesa
                    </button>
                </li>
            </ul>
        }

        @if (abaAtiva == "comandas" && Mesa.Id > 0)
        {
            <GestorComandasMesa MesaIdentificacao="@Mesa.Identificacao"
                                OnSelecionarComanda="SelecionarComandaParaPedido"
                                OnComandaCriada="HandleComandaCriada" />
        }
        else if (abaAtiva == "pedido" && Mesa.Id > 0)
        {
            <LancamentoRapido MesaIdentificacao="@Mesa.Identificacao"
                              ComandaAtiva="comandaParaPedido"
                              OnTrocarComanda='() => MudarAba("comandas")'
                              OnPedidoEnviado="HandlePedidoEnviado" />
        }
        else if (abaAtiva == "consumo" && Mesa.Id > 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt text-primary me-2"></i>Extrato de Consumo da @Mesa.Identificacao</h6>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CarregarItensConsumoAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i> Atualizar Itens
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (carregandoItens)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                            <span class="text-muted ms-2">Carregando itens pedidos...</span>
                        </div>
                    }
                    else if (!itensMesa.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-cart-x fs-1 opacity-25"></i>
                            <p class="mt-2 mb-0">Nenhum item lançado ainda para esta mesa.</p>
                            <button class="btn btn-sm btn-primary mt-3" @onclick='() => MudarAba("pedido")'>
                                <i class="bi bi-plus-lg me-1"></i> Lançar Primeiro Pedido
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produto</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">Preço Unit.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Status Cozinha (KDS)</th>
                                        <th>Observações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itensMesa)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@item.NomeProduto</td>
                                            <td class="text-center"><span class="badge bg-secondary">@item.Quantidade</span></td>
                                            <td class="text-end text-muted">R$ @item.PrecoUnitario.ToString("F2")</td>
                                            <td class="text-end fw-bold text-success">R$ @item.TotalItem.ToString("F2")</td>
                                            <td class="text-center">
                                                <span class="badge @ObterClasseStatusItem(item.Status)">@item.Status</span>
                                            </td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.Observacao) ? "-" : item.Observacao)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-end">Total do Consumo:</td>
                                        <td class="text-end text-success fs-6">R$ @itensMesa.Sum(i => i.TotalItem).ToString("F2")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <EditForm Model="Mesa" OnValidSubmit="Salvar">
                <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label class="form-label">Identificação</label>
                    <input type="text" class="form-control" @bind="Mesa.Identificacao" placeholder="Ex: Mesa 01, Balcão 2" />
                    <ValidationMessage For="@(() => Mesa.Identificacao)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Capacidade (Lugares)</label>
                    <input type="number" class="form-control" @bind="Mesa.Capacidade" min="1" max="50" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Status Atual</label>
                    <select class="form-select" @bind="Mesa.Status">
                        <option value="@StatusMesaConsts.Livre">Livre</option>
                        <option value="@StatusMesaConsts.Ocupada">Ocupada</option>
                        <option value="@StatusMesaConsts.AguardandoPagamento">Aguardando Pagamento</option>
                        <option value="@StatusMesaConsts.Reservada">Reservada</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Fechar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Salvar Mesa
                    </button>
                </div>
            </EditForm>
        }
    </BodyContent>
</Modal>

@code {
    [Parameter] public JT_Classes.Restaurante.Mesa Mesa { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    
    private Modal modalRef = default!;
    private string abaAtiva = "comandas";
    private JT_Food.Shared.Domain.Entities.Comanda? comandaParaPedido;
    private List<MItemComanda> itensMesa = new();
    private bool carregandoItens = false;

    public void Open(JT_Classes.Restaurante.Mesa? mesa = null, string abaInicial = "comandas")
    {
        if (mesa != null)
        {
            Mesa = mesa;
        }
        abaAtiva = Mesa.Id == 0 ? "dados" : abaInicial;
        comandaParaPedido = null;
        modalRef.Open();
        _ = GarantirComandaParaPedidoAsync();
        _ = CarregarItensConsumoAsync();
    }

    public void Close() => modalRef.Close();
    public bool IsOpen => modalRef.IsOpen;

    private async Task MudarAba(string aba)
    {
        abaAtiva = aba;
        if (aba == "pedido")
        {
            await GarantirComandaParaPedidoAsync();
        }
        else if (aba == "consumo")
        {
            await CarregarItensConsumoAsync();
        }
    }

    private async Task GarantirComandaParaPedidoAsync()
    {
        if (comandaParaPedido != null || string.IsNullOrWhiteSpace(Mesa.Identificacao)) return;
        try
        {
            var comandas = await ComandaService.ObterComandasDaMesaAsync(Mesa.Identificacao);
            var ativa = comandas.FirstOrDefault(c => c.Status != "Fechada" && c.Status != "Cancelada");
            if (ativa != null)
            {
                comandaParaPedido = new JT_Food.Shared.Domain.Entities.Comanda
                {
                    Id = ativa.Id,
                    NomeCliente = ativa.NomeCliente,
                    MesaId = ativa.MesaId,
                    Subtotal = ativa.Total
                };
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task CarregarItensConsumoAsync()
    {
        if (string.IsNullOrWhiteSpace(Mesa.Identificacao)) return;
        carregandoItens = true;
        try
        {
            var comandas = await ComandaService.ObterComandasDaMesaAsync(Mesa.Identificacao);
            var comandaIds = comandas.Select(c => c.Id.ToString()).ToHashSet();
            if (comandaIds.Any())
            {
                var allItens = await ItemComandaService.GetAll();
                itensMesa = (allItens ?? Enumerable.Empty<MItemComanda>())
                    .Where(i => !string.IsNullOrWhiteSpace(i.ComandaId) &&
                                (comandaIds.Contains(i.ComandaId) || comandaIds.Contains(i.ComandaId.Trim().TrimStart('#'))))
                    .OrderByDescending(i => i.Id)
                    .ToList();
            }
            else
            {
                itensMesa.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModalMesa CarregarItensConsumoAsync Error]: {ex.Message}");
        }
        finally
        {
            carregandoItens = false;
        }
        StateHasChanged();
    }

    public async Task SalvarAsync() => await Salvar();

    private async Task Salvar()
    {
        if (await MesaService.SaveAsync(Mesa) > 0)
        {
            await OnSaved.InvokeAsync();
            Close();
        }
    }

    private async Task HandleComandaCriada()
    {
        Mesa.Status = StatusMesaConsts.Ocupada;
        if (Mesa.Id > 0)
        {
            await MesaService.SaveAsync(Mesa);
        }
        await OnSaved.InvokeAsync();
        StateHasChanged();
    }

    private async Task SelecionarComandaParaPedido(JT_Classes.Restaurante.Comanda c)
    {
        Mesa.Status = StatusMesaConsts.Ocupada;
        if (Mesa.Id > 0)
        {
            await MesaService.SaveAsync(Mesa);
        }
        comandaParaPedido = new JT_Food.Shared.Domain.Entities.Comanda
        {
            Id = c.Id,
            NomeCliente = c.NomeCliente,
            MesaId = c.MesaId,
            Subtotal = c.Total
        };
        abaAtiva = "pedido";
        await OnSaved.InvokeAsync();
        StateHasChanged();
    }


    private async Task HandlePedidoEnviado()
    {
        if (Mesa.Id > 0)
        {
            var mesaAtualizada = await MesaService.GetById(Mesa.Id);
            if (mesaAtualizada != null)
            {
                Mesa = mesaAtualizada;
            }
            else
            {
                Mesa.Status = StatusMesaConsts.Ocupada;
            }
        }
        await CarregarItensConsumoAsync();
        await OnSaved.InvokeAsync();
        StateHasChanged();
    }

    private string ObterClasseStatusItem(string status)
    {
        return status switch
        {
            "Confirmado" => "bg-primary",
            "Em Produção" => "bg-warning text-dark",
            "Pronto" => "bg-info text-dark",
            "Saída para Entrega" => "bg-secondary",
            "Entregue" => "bg-success",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
