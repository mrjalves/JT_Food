@using JT_Classes.Restaurante
@using JT_Food.Shared.Services
@using JT_UserInterface.Shared.Components.Core

<Modal @ref="modalRef" Title="@(Mesa.Id == 0 ? "Nova Mesa" : "Editar Mesa")" EntidadeContexto="Mesa">
    <BodyContent>
        <EditForm Model="Mesa">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Identificação / Número</label>
                <input type="text" class="form-control" @bind="Mesa.Identificacao" placeholder="Ex: Mesa 01, Balcão 2" />
                <ValidationMessage For="@(() => Mesa.Identificacao)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Capacidade (Pessoas)</label>
                <input type="number" class="form-control" @bind="Mesa.Capacidade" />
            </div>
            <div class="mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="Mesa.Status">
                    <option value="@StatusMesa.Livre">Livre</option>
                    <option value="@StatusMesa.Ocupada">Ocupada</option>
                    <option value="@StatusMesa.AguardandoPagamento">Aguardando Pagamento</option>
                    <option value="@StatusMesa.Reservada">Reservada</option>
                </select>
            </div>
        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Save">Salvar</button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public Mesa Mesa { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private Modal modalRef = default!;

    public void Open() => modalRef.Open();
    public void Close() => modalRef.Close();

    private async Task Save()
    {
        if (MesaService.Save(Mesa))
        {
            await OnSaved.InvokeAsync();
            Close();
        }
    }
}
